<Application x:Class="Dukkan.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Colors.xaml"/>
                <ResourceDictionary Source="Theme/Base.xaml"/>
                <ResourceDictionary Source="Theme/Buttons.xaml"/>
                <ResourceDictionary Source="Theme/Inputs.xaml"/>
                <ResourceDictionary Source="Theme/Data.xaml"/>
                <ResourceDictionary Source="Theme/Feedback.xaml"/>
                <ResourceDictionary Source="Views/Dialogs.xaml"/>
                <ResourceDictionary Source="Views/DialogsPos.xaml"/>
                <ResourceDictionary Source="Views/DialogsAdmin.xaml"/>
                <ResourceDictionary Source="Views/DialogsSuppliers.xaml"/>
                <ResourceDictionary Source="Views/DialogsSupplierOperations.xaml"/>
                <ResourceDictionary Source="Views/DialogsStock.xaml"/>
                <ResourceDictionary Source="Views/DialogsCredit.xaml"/>
                <ResourceDictionary Source="Views/DialogsImport.xaml"/>
                <ResourceDictionary Source="Views/DialogsPromotions.xaml"/>
                <ResourceDictionary Source="Views/DialogsReports.xaml"/>
                <ResourceDictionary Source="Views/DialogsSearch.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
