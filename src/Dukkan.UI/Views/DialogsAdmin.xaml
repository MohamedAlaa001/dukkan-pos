    <DataTemplate DataType="{x:Type ui:RecoveryCodesViewModel}">
        <Border Style="{StaticResource DialogCard}" Width="{Binding Width}">
            <StackPanel>
                <ContentPresenter ContentTemplate="{StaticResource DialogHeaderTemplate}" Content="{ui:T Setup_CodesTitle}"/>
                <TextBlock Text="{ui:T Setup_CodesNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,-6,0,12"/>
                <Border Style="{StaticResource FlatCard}" Padding="20,12">
                    <ItemsControl ItemsSource="{Binding Codes}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="17" FontWeight="SemiBold" Margin="0,5" FlowDirection="LeftToRight"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Command="{Binding CopyCommand}" Content="{ui:T Action_Copy}" MinHeight="42"/>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding CloseCommand}" Content="{ui:T Setup_CodesSaved}" MinHeight="42"/>
                </Grid>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type ui:RestoreDoneViewModel}">
        <Border Style="{StaticResource DialogCard}" Width="{Binding Width}">
            <StackPanel>
                <TextBlock Text="{ui:T bk_restore_title}" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                <Border Background="{StaticResource SuccessTintBrush}" CornerRadius="10" Padding="16,12">
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" TextTrimming="None" Foreground="{StaticResource SuccessTextBrush}" FontWeight="Medium"/>
                </Border>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding CloseAppCommand}" Content="{ui:T Action_CloseApp}" MinHeight="44" Margin="0,18,0,0"/>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
