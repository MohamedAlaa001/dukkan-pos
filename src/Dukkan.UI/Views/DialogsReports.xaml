<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Dukkan.UI">
 <DataTemplate DataType="{x:Type ui:DailySummaryViewModel}"><Border Style="{StaticResource DialogCard}" Width="{Binding Width}"><Grid MaxHeight="620"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><ContentPresenter ContentTemplate="{StaticResource DialogHeaderTemplate}" Content="{ui:T Daily_Title}"/><TextBlock Text="{Binding Report.Date}" FlowDirection="LeftToRight"/><TextBlock Text="{Binding CashierName}" Margin="0,4,0,10"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
   <ItemsControl ItemsSource="{Binding Metrics}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Value}" FlowDirection="LeftToRight" TextAlignment="Right" FontWeight="SemiBold"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="{ui:T Daily_Methods}" Style="{StaticResource H3}" Margin="0,16,0,6"/><ItemsControl ItemsSource="{Binding Methods}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Net,StringFormat=N2}" FlowDirection="LeftToRight" TextAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="{ui:T Daily_Top}" Style="{StaticResource H3}" Margin="0,16,0,6"/><ItemsControl ItemsSource="{Binding TopItems}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Row.Quantity,StringFormat=N3}" FlowDirection="LeftToRight" TextAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="{ui:T Daily_Hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,14,0,0"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,6"/><WrapPanel><Button Content="{ui:T Daily_80}" Command="{Binding Print80Command}" Margin="0,0,8,0"/><Button Content="{ui:T Daily_A4}" Command="{Binding PrintA4Command}" Margin="0,0,8,0"/><Button Content="{ui:T Action_SavePdf}" Command="{Binding PdfCommand}" Margin="0,0,8,0"/><Button Content="{ui:T Action_Export}" Command="{Binding CsvCommand}"/></WrapPanel></StackPanel>
 </Grid></Border></DataTemplate>
</ResourceDictionary>
