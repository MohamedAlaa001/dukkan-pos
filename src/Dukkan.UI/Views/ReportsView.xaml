<UserControl x:Class="Dukkan.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Dukkan.UI"
             xmlns:v="clr-namespace:Dukkan.UI.Views">
    <UserControl.Resources><Style x:Key="PaymentReportHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderRight}"><Setter Property="FlowDirection" Value="LeftToRight"/></Style></UserControl.Resources>
    <Grid Margin="24,12,24,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
            <TextBlock Text="{ui:T Nav_Reports}" Style="{StaticResource H1}" VerticalAlignment="Center"/>
            <Button Command="{Binding ExportCommand}" HorizontalAlignment="Right" MinWidth="120">
                <StackPanel Orientation="Horizontal"><ui:GlyphIcon Glyph="{x:Static ui:Icons.Download}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="{ui:T Action_Export}"/></StackPanel>
            </Button>
        </Grid>

        <!-- Shared filters (date range and cashier) for every report tab -->
        <StackPanel Grid.Row="1" Margin="0,4,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{ui:T Rep_From}" VerticalAlignment="Center" FontWeight="Medium" Margin="0,0,10,0"/>
                <TextBox Text="{Binding From, UpdateSourceTrigger=LostFocus}" ui:Ui.Icon="{x:Static ui:Icons.Calendar}" ui:Ui.Placeholder="dd/mm/yyyy" Width="170" FlowDirection="LeftToRight" AutomationProperties.Name="From date"/>
                <TextBlock Text="{ui:T Rep_To}" VerticalAlignment="Center" FontWeight="Medium" Margin="14,0,10,0"/>
                <TextBox Text="{Binding To, UpdateSourceTrigger=LostFocus}" ui:Ui.Icon="{x:Static ui:Icons.Calendar}" ui:Ui.Placeholder="dd/mm/yyyy" Width="170" FlowDirection="LeftToRight" AutomationProperties.Name="To date"/>
                <ComboBox ItemsSource="{Binding Cashiers}" SelectedItem="{Binding Cashier}" Width="190" Margin="14,0,0,0" AutomationProperties.Name="Cashier"/>
            </StackPanel>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding DateError}"/>
        </StackPanel>

        <TabControl Grid.Row="2" SelectedIndex="{Binding Tab, Mode=TwoWay}">
            <!-- Sales report -->
            <TabItem Header="{ui:T Rep_TabSales}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,6,0">
                    <Grid>
                        <StackPanel>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ui:StatCard Caption="{ui:T Dash_TotalSales}" Value="{Binding TotalSales, StringFormat=N0}" Glyph="{x:Static ui:Icons.Cart}" Tint="{StaticResource SuccessTintBrush}" Accent="{StaticResource SuccessBrush}"/>
                                <ui:StatCard Grid.Column="2" Caption="{ui:T Dash_Invoices}" Value="{Binding TotalInvoices, StringFormat=N0}" Glyph="{x:Static ui:Icons.Document}" Tint="{StaticResource InfoTintBrush}" Accent="{StaticResource NavyLightBrush}"/>
                                <ui:StatCard Grid.Column="4" Caption="{ui:T Dash_ItemsSold}" Value="{Binding ItemsSold, StringFormat=N0}" Glyph="{x:Static ui:Icons.Bag}" Tint="{StaticResource OrangeTintBrush}" Accent="{StaticResource OrangeBrush}"/>
                                <ui:StatCard Grid.Column="6" Caption="{ui:T Rep_AvgInvoice}" Value="{Binding AvgInvoice, StringFormat=N0}" Glyph="{x:Static ui:Icons.Chart}" Tint="{StaticResource SuccessTintBrush}" Accent="{StaticResource SuccessBrush}"/>
                            </Grid>

                            <Border Style="{StaticResource Card}" Padding="22,16" Height="240" Margin="0,0,0,16">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{ui:T Rep_Trend}" Style="{StaticResource H3}" Margin="0,0,0,6"/>
                                    <ui:AreaChart Items="{Binding Series}" FlowDirection="LeftToRight"/>
                                </DockPanel>
                            </Border>

                            <TextBlock Text="{ui:T Rep_TopSelling}" Style="{StaticResource H3}" Margin="0,0,0,10"/>
                            <Border Style="{StaticResource Card}" ClipToBounds="True">
                                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding TopProducts}" RowHeight="44" VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Top selling products">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding No}" Width="70" ElementStyle="{StaticResource Ltr}"/>
                                        <DataGridTextColumn Header="{ui:T Col_Product}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                        <DataGridTextColumn Header="{ui:T Col_Qty}" Binding="{Binding Qty}" Width="150" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource GridHeaderRight}"/>
                                        <DataGridTextColumn Header="{ui:T Col_TotalEgp}" Binding="{Binding Total, StringFormat=N0}" Width="200" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource GridHeaderRight}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                        <ContentControl Style="{StaticResource LoadingOverlay}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Sales history -->
            <TabItem Header="{ui:T Rep_TabHistory}">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="420"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Icon="{x:Static ui:Icons.Search}" ui:Ui.Placeholder="{ui:T Rep_SearchPh}" AutomationProperties.Name="Search invoices"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="160" Margin="12,0,0,0" AutomationProperties.Name="Status"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding PayFilters}" SelectedItem="{Binding PayFilter}" Width="160" Margin="12,0,0,0" AutomationProperties.Name="Payment method"/>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Pager.Items}" RowHeight="46" AutomationProperties.Name="Sales history">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{ui:T Col_Invoice}" Binding="{Binding Number}" Width="140" ElementStyle="{StaticResource Ltr}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Date}" Binding="{Binding DateText}" Width="160" ElementStyle="{StaticResource Ltr}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Customer}" Binding="{Binding Customer}" Width="*" MinWidth="150" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Cashier}" Binding="{Binding Cashier}" Width="130" ElementStyle="{StaticResource CellMuted}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Items}" Binding="{Binding Items}" Width="80" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource GridHeaderRight}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Payment}" Binding="{Binding Payment}" Width="150" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Total}" Binding="{Binding Total, StringFormat=N0}" Width="110" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource GridHeaderRight}"/>
                                    <DataGridTemplateColumn Header="{ui:T Col_Status}" Width="130">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ui:Badge Kind="{Binding StatusKind}" VerticalAlignment="Center"><TextBlock Text="{Binding Status}"/></ui:Badge></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource IconButtonSmall}" HorizontalAlignment="Center" Command="{Binding DataContext.ViewInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" AutomationProperties.Name="View invoice">
                                                    <ui:GlyphIcon Glyph="{x:Static ui:Icons.Eye}" FontSize="13"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <ui:EmptyState Glyph="{x:Static ui:Icons.Document}" Title="{ui:T Empty_NoInvoices}" Message="{ui:T Empty_NoInvoicesMsg}" Visibility="{Binding Pager.TotalCount, Converter={StaticResource CountToVis}}"/>
                            <v:PaginationBar Grid.Row="1" DataContext="{Binding Pager}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Shifts: cash reconciliation history -->
            <TabItem Header="{ui:T Rep_TabShifts}">
                <Border Style="{StaticResource Card}" ClipToBounds="True" Margin="0,14,0,0">
                    <Grid>
                        <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Shifts}" RowHeight="48" AutomationProperties.Name="Shift history">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{ui:T Col_Date}" Binding="{Binding Date}" Width="120" ElementStyle="{StaticResource Ltr}"/>
                                <DataGridTextColumn Header="{ui:T Col_Cashier}" Binding="{Binding Cashier}" Width="*" MinWidth="130" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="{ui:T Shift_Opened}" Binding="{Binding Opened}" Width="80" ElementStyle="{StaticResource Ltr}"/>
                                <DataGridTextColumn Header="{ui:T Shift_Closed}" Binding="{Binding Closed}" Width="80" ElementStyle="{StaticResource Ltr}"/>
                                <DataGridTextColumn Header="{ui:T Shift_Float}" Binding="{Binding Float, StringFormat=N2}" Width="100" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource GridHeaderRight}"/>
                                <DataGridTextColumn Header="{ui:T Shift_Expected}" Binding="{Binding Expected}" Width="110" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource GridHeaderRight}"/>
                                <DataGridTextColumn Header="{ui:T Shift_Counted}" Binding="{Binding Counted}" Width="110" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource GridHeaderRight}"/>
                                <DataGridTemplateColumn Header="{ui:T Shift_Variance}" Width="110" HeaderStyle="{StaticResource GridHeaderRight}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Variance}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" FlowDirection="LeftToRight">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Style.Triggers><DataTrigger Binding="{Binding HasVariance}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{ui:T Shift_Reason}" Binding="{Binding Reason}" Width="*" MinWidth="120" ElementStyle="{StaticResource CellMuted}"/>
                                <DataGridTemplateColumn Header="{ui:T Col_Status}" Width="110">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><ui:Badge Kind="{Binding StatusKind}" VerticalAlignment="Center"><TextBlock Text="{Binding Status}"/></ui:Badge></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ui:EmptyState Glyph="{x:Static ui:Icons.Calendar}" Title="{ui:T Empty_NoShifts}" Message="{ui:T Empty_NoShiftsMsg}" Visibility="{Binding Shifts.Count, Converter={StaticResource CountToVis}}"/>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="{ui:T Pay_MethodBreakdown}">
                <Border Style="{StaticResource Card}" Padding="18"><DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14"><TextBlock Text="{ui:T Pay_MethodTotalsHint}" Style="{StaticResource Caption}" TextWrapping="Wrap"/><Button Command="{Binding ExportMethodsCommand}" Content="{ui:T Action_Export}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel>
                    <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding PaymentTotals}" RowHeight="46"><DataGrid.Columns>
                        <DataGridTextColumn Header="{ui:T Pay_Method}" Binding="{Binding Name}" Width="*" MinWidth="150" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="{ui:T Pay_SalesReceived}" Binding="{Binding Row.Sales,StringFormat=N2}" Width="135" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource PaymentReportHeader}"/>
                        <DataGridTextColumn Header="{ui:T Pay_Collections}" Binding="{Binding Row.Collections,StringFormat=N2}" Width="130" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource PaymentReportHeader}"/>
                        <DataGridTextColumn Header="{ui:T Pay_Refunds}" Binding="{Binding Row.Refunds,StringFormat=N2}" Width="130" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource PaymentReportHeader}"/>
                        <DataGridTextColumn Header="{ui:T Pay_SupplierPaid}" Binding="{Binding Row.SupplierPayments,StringFormat=N2}" Width="135" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource PaymentReportHeader}"/>
                        <DataGridTextColumn Header="{ui:T Pay_NetReceived}" Binding="{Binding Net,StringFormat=N2}" Width="130" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource PaymentReportHeader}"/>
                    </DataGrid.Columns></DataGrid>
                </DockPanel></Border>
            </TabItem>
            <TabItem Header="{ui:T Smart_Title}"><v:SmartReportsView DataContext="{Binding Smart}"/></TabItem>
        </TabControl>
    </Grid>
</UserControl>
