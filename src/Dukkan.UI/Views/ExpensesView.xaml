<UserControl x:Class="Dukkan.UI.Views.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Dukkan.UI"
             xmlns:v="clr-namespace:Dukkan.UI.Views">
    <Grid Margin="24,12,24,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <TextBlock Text="{ui:T Nav_Expenses}" Style="{StaticResource H1}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding CashCommand}" MinWidth="150" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal"><ui:GlyphIcon Glyph="{x:Static ui:Icons.Money}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="{ui:T Cash_Title}"/></StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" MinWidth="160">
                    <StackPanel Orientation="Horizontal"><ui:GlyphIcon Glyph="{x:Static ui:Icons.Add}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{ui:T Exp_Add}" FontWeight="SemiBold"/></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ui:StatCard Caption="{ui:T Exp_Month}" Value="{Binding MonthTotal, StringFormat=N0}" Glyph="{x:Static ui:Icons.Calculator}" Tint="{StaticResource OrangeTintBrush}" Accent="{StaticResource OrangeBrush}"/>
            <ui:StatCard Grid.Column="2" Caption="{ui:T Exp_Today}" Value="{Binding TodayTotal, StringFormat=N0}" Glyph="{x:Static ui:Icons.Calendar}" Tint="{StaticResource InfoTintBrush}" Accent="{StaticResource NavyLightBrush}"/>
            <ui:StatCard Grid.Column="4" Caption="{ui:T Exp_Cash}" Value="{Binding RegisterTotal, StringFormat=N0}" Glyph="{x:Static ui:Icons.Money}" Tint="{StaticResource SuccessTintBrush}" Accent="{StaticResource SuccessBrush}"/>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Pager.Items}" RowHeight="46" AutomationProperties.Name="Expenses">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{ui:T Col_Date}" Binding="{Binding DateText}" Width="130" ElementStyle="{StaticResource Ltr}"/>
                        <DataGridTemplateColumn Header="{ui:T Col_Category}" Width="150">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ui:Badge Kind="Info" VerticalAlignment="Center"><TextBlock Text="{Binding Category}"/></ui:Badge></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{ui:T Col_Description}" Binding="{Binding Description}" Width="*" MinWidth="200" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="{ui:T Exp_PaidBy}" Binding="{Binding PaidBy}" Width="130" ElementStyle="{StaticResource CellMuted}"/>
                        <DataGridTextColumn Header="{ui:T Col_Amount}" Binding="{Binding Amount, StringFormat=N0}" Width="130" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource GridHeaderRight}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <ui:EmptyState Glyph="{x:Static ui:Icons.Calculator}" Title="{ui:T Empty_NoExpenses}" Message="{ui:T Empty_NoExpensesMsg}" Visibility="{Binding Pager.TotalCount, Converter={StaticResource CountToVis}}"/>
                <v:PaginationBar Grid.Row="1" DataContext="{Binding Pager}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
