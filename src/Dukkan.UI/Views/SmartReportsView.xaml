<UserControl x:Class="Dukkan.UI.Views.SmartReportsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Dukkan.UI">
 <UserControl.Resources><Style x:Key="SmartNumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderRight}"><Setter Property="FlowDirection" Value="LeftToRight"/></Style></UserControl.Resources>
 <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <WrapPanel><ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" Width="240" Margin="0,0,12,8"/>
   <StackPanel Orientation="Horizontal" Visibility="{Binding IsDead,Converter={StaticResource BoolToVis}}"><TextBlock Text="{ui:T Smart_Days}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding Days,UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,12,8" FlowDirection="LeftToRight"/></StackPanel>
   <Button Content="{ui:T Action_Export}" Command="{Binding ExportCommand}" Margin="0,0,12,8"/><Button Content="{ui:T Daily_Open}" Command="{Binding DailyCommand}" Margin="0,0,0,8"/>
  </WrapPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,10"><TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" TextWrapping="Wrap"/><TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}"/></StackPanel>
  <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <ui:StatCard Caption="{ui:T Smart_Revenue}" Value="{Binding Revenue,StringFormat=N2}" Glyph="{x:Static ui:Icons.Cart}" Visibility="{Binding IsProfit,Converter={StaticResource BoolToVis}}"/>
   <ui:StatCard Grid.Column="2" Caption="{ui:T Smart_Cost}" Value="{Binding Cost,StringFormat=N2}" Glyph="{x:Static ui:Icons.Bag}" Visibility="{Binding IsProfit,Converter={StaticResource BoolToVis}}"/>
   <ui:StatCard Grid.Column="4" Caption="{ui:T Smart_Profit}" Value="{Binding Profit,StringFormat=N2}" Glyph="{x:Static ui:Icons.Chart}" Visibility="{Binding IsProfit,Converter={StaticResource BoolToVis}}"/>
   <ui:StatCard Caption="{ui:T Smart_CostValue}" Value="{Binding CostValue,StringFormat=N2}" Glyph="{x:Static ui:Icons.Package}" Visibility="{Binding IsStock,Converter={StaticResource BoolToVis}}"/>
   <ui:StatCard Grid.Column="2" Caption="{ui:T Smart_RetailValue}" Value="{Binding RetailValue,StringFormat=N2}" Glyph="{x:Static ui:Icons.Tag}" Visibility="{Binding IsStock,Converter={StaticResource BoolToVis}}"/>
  </Grid>
  <Border Grid.Row="3" Style="{StaticResource Card}" ClipToBounds="True"><Grid>
   <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource DataTable}" RowHeight="44" Visibility="{Binding IsProfit,Converter={StaticResource BoolToVis}}"><DataGrid.Columns>
    <DataGridTextColumn Header="{ui:T Smart_Name}" Binding="{Binding Name}" Width="250" ElementStyle="{StaticResource CellText}"/>
    <DataGridTextColumn Header="{ui:T Col_Qty}" Binding="{Binding Row.Quantity,StringFormat=N3}" Width="100" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SmartNumberHeader}"/>
    <DataGridTextColumn Header="{ui:T Smart_Revenue}" Binding="{Binding Row.Revenue,StringFormat=N2}" Width="160" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SmartNumberHeader}"/>
    <DataGridTextColumn Header="{ui:T Smart_Cost}" Binding="{Binding Row.Cost,StringFormat=N2}" Width="150" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SmartNumberHeader}"/>
    <DataGridTextColumn Header="{ui:T Smart_Profit}" Binding="{Binding Row.Profit,StringFormat=N2}" Width="140" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SmartNumberHeader}"/>
    <DataGridTextColumn Header="{ui:T Smart_Margin}" Binding="{Binding Row.Margin,StringFormat=N2}" Width="115" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SmartNumberHeader}"/>
    <DataGridTextColumn Header="{ui:T Smart_Discounts}" Binding="{Binding Row.Discounts,StringFormat=N2}" Width="145" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SmartNumberHeader}"/>
    <DataGridTextColumn Header="{ui:T Smart_Returns}" Binding="{Binding Row.Returns,StringFormat=N2}" Width="150" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SmartNumberHeader}"/>
    <DataGridTextColumn Header="{ui:T Smart_TaxAmount}" Binding="{Binding Row.Tax,StringFormat=N2}" Width="120" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SmartNumberHeader}"/>
   </DataGrid.Columns></DataGrid>
   <DataGrid ItemsSource="{Binding Stock}" Style="{StaticResource DataTable}" RowHeight="44" Visibility="{Binding IsStock,Converter={StaticResource BoolToVis}}"><DataGrid.Columns>
    <DataGridTextColumn Header="{ui:T Col_Product}" Binding="{Binding Name}" Width="*" MinWidth="230" ElementStyle="{StaticResource CellText}"/>
    <DataGridTextColumn Header="{ui:T Col_Qty}" Binding="{Binding Row.Quantity,StringFormat=N3}" Width="120" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SmartNumberHeader}"/>
    <DataGridTextColumn Header="{ui:T Smart_CostValue}" Binding="{Binding Row.CostValue,StringFormat=N2}" Width="170" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SmartNumberHeader}"/>
    <DataGridTextColumn Header="{ui:T Smart_RetailValue}" Binding="{Binding Row.RetailValue,StringFormat=N2}" Width="180" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SmartNumberHeader}"/>
    <DataGridTextColumn Header="{ui:T Smart_LastSale}" Binding="{Binding LastSale}" Width="150" ElementStyle="{StaticResource Ltr}"/>
   </DataGrid.Columns></DataGrid>
   <DataGrid ItemsSource="{Binding Taxes}" Style="{StaticResource DataTable}" RowHeight="44" Visibility="{Binding IsTax,Converter={StaticResource BoolToVis}}"><DataGrid.Columns>
    <DataGridTextColumn Header="{ui:T Smart_Rate}" Binding="{Binding Rate,StringFormat=N2}" Width="*" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SmartNumberHeader}"/>
    <DataGridTextColumn Header="{ui:T Smart_Revenue}" Binding="{Binding Taxable,StringFormat=N2}" Width="*" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SmartNumberHeader}"/>
    <DataGridTextColumn Header="{ui:T Smart_TaxAmount}" Binding="{Binding Tax,StringFormat=N2}" Width="*" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SmartNumberHeader}"/>
   </DataGrid.Columns></DataGrid>
   <ui:EmptyState Glyph="{x:Static ui:Icons.Chart}" Title="{ui:T Smart_Empty}" Visibility="{Binding IsEmpty,Converter={StaticResource BoolToVis}}"/>
  </Grid></Border>
 </Grid>
</UserControl>
