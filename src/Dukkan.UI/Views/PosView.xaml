<UserControl x:Class="Dukkan.UI.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Dukkan.UI">
    <Grid Margin="24,12,24,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <TextBlock Text="{ui:T Pos_Title}" Style="{StaticResource H1}" VerticalAlignment="Center"/>
            <!-- A sale needs an open shift; the owner or cashier opens it explicitly. -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource WarningTintBrush}" CornerRadius="8" Padding="12,6"
                    Visibility="{Binding Shell.NoShift, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ui:GlyphIcon Glyph="{x:Static ui:Icons.Warning}" FontSize="14" Foreground="{StaticResource WarningTextBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{ui:T Pos_NeedShift}" Foreground="{StaticResource WarningTextBrush}" FontWeight="Medium" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource OutlineButton}" Command="{Binding Shell.OpenShiftCommand}" Content="{ui:T Shift_OpenTitle}" MinHeight="30" Margin="12,0,0,0" Padding="12,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Search + actions -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="PosSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Icon="{x:Static ui:Icons.Search}" ui:Ui.Placeholder="{ui:T Pos_SearchPh}" AutomationProperties.Name="Scan or search">
                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SubmitSearchCommand}"/></TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Style="{StaticResource WarnOutlineButton}" Command="{Binding HoldCommand}" Margin="12,0,0,0" MinWidth="104">
                <TextBlock Text="{ui:T Pos_Hold}" FontWeight="SemiBold"/>
            </Button>
            <Button Grid.Column="2" Command="{Binding DiscountCommand}" Margin="8,0,0,0" MinWidth="104">
                <StackPanel Orientation="Horizontal"><ui:GlyphIcon Glyph="{x:Static ui:Icons.Tag}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="{ui:T Pos_Discount}"/></StackPanel>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource DangerOutlineButton}" Command="{Binding ClearCommand}" Margin="8,0,0,0" MinWidth="92">
                <StackPanel Orientation="Horizontal"><ui:GlyphIcon Glyph="{x:Static ui:Icons.Delete}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="{ui:T Pos_Clear}"/></StackPanel>
            </Button>
        </Grid>

        <!-- Category chips -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Categories}" Margin="0,0,0,14" KeyboardNavigation.DirectionalNavigation="Contained">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton GroupName="poscat" Style="{StaticResource ChipRadio}" Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                 CommandParameter="{Binding}">
                        <RadioButton.Content>
                            <TextBlock Text="{Binding Converter={x:Static ui:CategoryLabelConverter.Instance}}"/>
                        </RadioButton.Content>
                        <RadioButton.IsChecked>
                            <MultiBinding Converter="{x:Static ui:ChipCheckedConverter.Instance}" Mode="OneWay">
                                <Binding/>
                                <Binding Path="DataContext.Category" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                            </MultiBinding>
                        </RadioButton.IsChecked>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="450" MaxWidth="540"/></Grid.ColumnDefinitions>

            <!-- Product grid: one tile per style; several variants open the size/color picker -->
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ProductCardButton}" Width="134" Margin="0,0,10,10" Command="{Binding DataContext.AddStyleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                    <StackPanel>
                                        <Border Style="{StaticResource ThumbTile}" Height="100">
                                            <Grid>
                                                <ui:GarmentThumb Kind="{Binding Kind}" Image="{Binding Image}" Foreground="{Binding ColorHex, Converter={StaticResource HexBrush}}"/>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Padding="6,1" CornerRadius="4" Background="{StaticResource DangerBrush}"
                                                        Visibility="{Binding StockIsCritical, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding TotalStock}" Foreground="White" FontSize="11" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,8,2,0"/>
                                        <Grid Margin="2,2,2,0">
                                            <TextBlock Text="{Binding BasePrice, Converter={StaticResource MoneyConv}}" Style="{StaticResource Caption}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding VariantsText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <ui:EmptyState Glyph="{x:Static ui:Icons.Search}" Title="{ui:T Empty_NoProducts}" Message="{ui:T Empty_NoProductsMsg}"
                               Visibility="{Binding Products.Count, Converter={StaticResource CountToVis}}"/>
            </Grid>

            <!-- Cart -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" Height="42" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c0"/><ColumnDefinition Width="*" MinWidth="40"/><ColumnDefinition Width="Auto" SharedSizeGroup="c2"/><ColumnDefinition Width="Auto" SharedSizeGroup="c3"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="c4"/><ColumnDefinition Width="Auto" SharedSizeGroup="c5"/><ColumnDefinition Width="Auto" SharedSizeGroup="c6"/><ColumnDefinition Width="Auto" SharedSizeGroup="c7"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="#" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="22"/>
                            <TextBlock Grid.Column="1" Text="{ui:T Col_Product}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{ui:T Col_Size}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="34" Margin="4,0"/>
                            <TextBlock Grid.Column="3" Text="{ui:T Col_Color}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="50" Margin="4,0"/>
                            <TextBlock Grid.Column="4" Text="{ui:T Col_Qty}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="76" TextAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="{ui:T Col_Price}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="46" TextAlignment="Right" Margin="4,0" FlowDirection="LeftToRight"/>
                            <TextBlock Grid.Column="6" Text="{ui:T Col_Total}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="54" TextAlignment="Right" FlowDirection="LeftToRight"/>
                            <Border Grid.Column="7" Width="30"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Cart}" KeyboardNavigation.TabNavigation="Continue" AlternationCount="1000">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6" MinHeight="50">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c0"/><ColumnDefinition Width="*" MinWidth="40"/><ColumnDefinition Width="Auto" SharedSizeGroup="c2"/><ColumnDefinition Width="Auto" SharedSizeGroup="c3"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="c4"/><ColumnDefinition Width="Auto" SharedSizeGroup="c5"/><ColumnDefinition Width="Auto" SharedSizeGroup="c6"/><ColumnDefinition Width="Auto" SharedSizeGroup="c7"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={x:Static ui:RowNumberConverter.Instance}}"
                                                           VerticalAlignment="Center" MinWidth="22" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Medium"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Size}" VerticalAlignment="Center" MinWidth="34" Margin="4,0" FlowDirection="LeftToRight"/>
                                                <TextBlock Grid.Column="3" Text="{Binding ColorName}" VerticalAlignment="Center" MinWidth="50" Margin="4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" MinWidth="76" FlowDirection="LeftToRight">
                                                    <Button Style="{StaticResource IconButtonSmall}" Width="24" Height="24" MinHeight="24" Command="{Binding DataContext.DecreaseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="Decrease quantity">
                                                        <ui:GlyphIcon Glyph="{x:Static ui:Icons.Remove}" FontSize="11"/>
                                                    </Button>
                                                    <TextBlock Text="{Binding Qty}" Width="24" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Visibility="{Binding CanEditQty, Converter={StaticResource InvBoolToVis}}"/>
                                                    <TextBox Text="{Binding QtyText, UpdateSourceTrigger=LostFocus}" Width="58" MinHeight="26" Padding="2,0" TextAlignment="Center" VerticalContentAlignment="Center" FontWeight="SemiBold" ToolTip="{Binding Variant.UnitLabel}"
                                                             Visibility="{Binding CanEditQty, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Quantity"/>
                                                    <Button Style="{StaticResource IconButtonSmall}" Width="24" Height="24" MinHeight="24" Command="{Binding DataContext.IncreaseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="Increase quantity">
                                                        <ui:GlyphIcon Glyph="{x:Static ui:Icons.Add}" FontSize="11"/>
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock Grid.Column="5" Text="{Binding Price, Converter={StaticResource NumberConv}}" VerticalAlignment="Center" MinWidth="46" TextAlignment="Right" Margin="4,0" FlowDirection="LeftToRight"/>
                                                <TextBlock Grid.Column="6" Text="{Binding Total, Converter={StaticResource NumberConv}}" VerticalAlignment="Center" MinWidth="54" TextAlignment="Right" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
                                                <Button Grid.Column="7" Style="{StaticResource IconButtonDanger}" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                        Width="30" Height="30" MinHeight="30" AutomationProperties.Name="Remove line">
                                                    <ui:GlyphIcon Glyph="{x:Static ui:Icons.Delete}" FontSize="14"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <ui:EmptyState Glyph="{x:Static ui:Icons.Cart}" Title="{ui:T Empty_Cart}" Message="{ui:T Empty_CartMsg}" Visibility="{Binding Cart.Count, Converter={StaticResource CountToVis}}"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="18,12,18,18">
                        <TextBox Text="{Binding Coupon,UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{ui:T Promo_Coupon}" Margin="0,0,0,10" FlowDirection="LeftToRight"/>
                        <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" Visibility="{Binding AppliedOffers.Count,Converter={StaticResource CountToVis},ConverterParameter=NotEmpty}">
                            <ItemsControl ItemsSource="{Binding AppliedOffers}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding Amount,Converter={StaticResource NumberConv}}" FlowDirection="LeftToRight" FontWeight="SemiBold" Margin="8,0"/><Button Grid.Column="2" Style="{StaticResource IconButtonDanger}" Command="{Binding DataContext.RemoveOfferCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{ui:T Promo_Remove}" Width="30" Height="28"><ui:GlyphIcon Glyph="{x:Static ui:Icons.Close}"/></Button></Grid>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </ScrollViewer>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{ui:T Pay_Customer}" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" MinHeight="34" AutomationProperties.Name="Customer"/>
                        </Grid>
                        <Grid Margin="0,0,0,6"><TextBlock Text="{ui:T Pos_Subtotal}" Style="{StaticResource Caption}" FontSize="13"/><TextBlock Text="{Binding Subtotal, Converter={StaticResource NumberConv}}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FlowDirection="LeftToRight"/></Grid>
                        <Grid Margin="0,0,0,10"><TextBlock Text="{ui:T Pos_DiscountLine}" Style="{StaticResource Caption}" FontSize="13"/><TextBlock Text="{Binding Discount, Converter={StaticResource NumberConv}}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FlowDirection="LeftToRight"/></Grid>
                        <Grid Margin="0,0,0,6" Visibility="{Binding HasCustomer,Converter={StaticResource BoolToVis}}"><TextBlock Text="{ui:T Loyalty_Balance}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding PointsBalance}" Style="{StaticResource Caption}" HorizontalAlignment="Right" FlowDirection="LeftToRight"/></Grid>
                        <Grid Margin="0,0,0,6" Visibility="{Binding HasTax,Converter={StaticResource BoolToVis}}"><TextBlock Text="{ui:T Promo_Tax}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Tax,Converter={StaticResource NumberConv}}" Style="{StaticResource Caption}" HorizontalAlignment="Right" FlowDirection="LeftToRight"/></Grid>
                        <TextBlock Text="{Binding PricingError}" Style="{StaticResource ErrorText}" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource Divider}"/>
                        <Grid Margin="0,12,0,14">
                            <TextBlock Text="{ui:T Pos_Total}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Total, Converter={StaticResource MoneyConv}}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" FlowDirection="LeftToRight"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                            <Button Command="{Binding ShowHeldCommand}" MinHeight="46" FontWeight="SemiBold"><TextBlock Text="{Binding HeldButtonText}"/></Button>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding PayCommand}" MinHeight="46" FontSize="14">
                                <TextBlock Text="{ui:T Pos_Pay}" FontWeight="Bold" FontSize="14"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
