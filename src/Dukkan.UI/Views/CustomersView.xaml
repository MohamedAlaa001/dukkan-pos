<UserControl x:Class="Dukkan.UI.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Dukkan.UI"
             xmlns:v="clr-namespace:Dukkan.UI.Views">
    <Grid>
        <!-- ===== List ===== -->
        <Grid Margin="24,12,24,24" Visibility="{Binding IsListVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="{ui:T Nav_Customers}" Style="{StaticResource H1}" Margin="0,0,0,14"/>
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="460"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Icon="{x:Static ui:Icons.Search}" ui:Ui.Placeholder="{ui:T Cust_SearchPh}" AutomationProperties.Name="Search customers"/>
                <Button Grid.Column="1" Command="{Binding DueCommand}" HorizontalAlignment="Right" MinWidth="170" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal"><ui:GlyphIcon Glyph="{x:Static ui:Icons.Calendar}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="{ui:T Due_Title}"/></StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" MinWidth="160">
                    <StackPanel Orientation="Horizontal"><ui:GlyphIcon Glyph="{x:Static ui:Icons.Add}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{ui:T Cust_Add}" FontWeight="SemiBold"/></StackPanel>
                </Button>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Pager.Items}" SelectedItem="{Binding Selected}" RowHeight="52" AutomationProperties.Name="Customers table">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
                                <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick"/>
                                <EventSetter Event="KeyDown" Handler="Row_KeyDown"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="#" Width="56">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Id}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FlowDirection="LeftToRight" HorizontalAlignment="Left"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{ui:T Col_Name}" Width="*" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource InfoTintBrush}" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Initials}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource NavyLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{ui:T Col_Phone}" Binding="{Binding Phone}" Width="150" ElementStyle="{StaticResource Ltr}"/>
                            <DataGridTextColumn Header="{ui:T Col_TotalPurchases}" Binding="{Binding TotalPurchases, StringFormat=N0}" Width="160" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource GridHeaderRight}"/>
                            <DataGridTemplateColumn Header="{ui:T Col_Outstanding}" Width="140" HeaderStyle="{StaticResource GridHeaderRight}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Outstanding, StringFormat=N0}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Medium" FlowDirection="LeftToRight">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasOutstanding}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{ui:T Col_Status}" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><ui:Badge Kind="{Binding StatusKind}" VerticalAlignment="Center"><TextBlock Text="{Binding Status}"/></ui:Badge></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" MinHeight="32" Padding="10,0" HorizontalAlignment="Right" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{ui:T Action_View}" FontWeight="SemiBold"/><ui:GlyphIcon Glyph="{Binding NextGlyph, Source={x:Static ui:Localizer.Instance}}" FontSize="10" Margin="6,0,0,0"/></StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ui:EmptyState Glyph="{x:Static ui:Icons.People}" Title="{ui:T Empty_NoCustomers}" Message="{ui:T Empty_NoCustomersMsg}" Visibility="{Binding Pager.TotalCount, Converter={StaticResource CountToVis}}"/>
                    <v:PaginationBar Grid.Row="1" DataContext="{Binding Pager}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Details ===== -->
        <Grid Margin="24,12,24,24" DataContext="{Binding Details}" Visibility="{Binding DataContext.IsDetailsVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="{ui:T Cust_Details}" Style="{StaticResource H1}" Margin="0,0,0,10"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.BackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="32" Height="32" MinHeight="32" Margin="0,0,6,0" AutomationProperties.Name="Back to customers">
                    <ui:GlyphIcon Glyph="{Binding BackGlyph, Source={x:Static ui:Localizer.Instance}}" FontSize="14"/>
                </Button>
                <TextBlock Text="{ui:T Nav_Customers}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <ui:GlyphIcon Glyph="{Binding NextGlyph, Source={x:Static ui:Localizer.Instance}}" FontSize="10" Foreground="{StaticResource PlaceholderBrush}" Margin="10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Customer.Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Profile + summary -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource NavyBrush}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Customer.Initials}" FontSize="19" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Customer.Name}" Style="{StaticResource H2}" Margin="0,0,10,0"/><ui:Badge Kind="{Binding Customer.StatusKind}" VerticalAlignment="Center"><TextBlock Text="{Binding Customer.Status}"/></ui:Badge></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><ui:GlyphIcon Glyph="{x:Static ui:Icons.Phone}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding Customer.Phone}" FlowDirection="LeftToRight"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><ui:GlyphIcon Glyph="{x:Static ui:Icons.Mail}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding Customer.Email}" FlowDirection="LeftToRight"/></StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <ui:StatCard Grid.Column="2" Caption="{ui:T Col_TotalPurchases}" Value="{Binding Customer.TotalPurchases, StringFormat=N0}" Glyph="{x:Static ui:Icons.Bag}" Tint="{StaticResource OrangeTintBrush}" Accent="{StaticResource OrangeBrush}"/>
                <ui:StatCard Grid.Column="4" Caption="{ui:T Col_Outstanding}" Value="{Binding Customer.Outstanding, StringFormat=N0}" Glyph="{x:Static ui:Icons.Money}" Tint="{StaticResource DangerTintBrush}" Accent="{StaticResource DangerBrush}"/>
                <ui:StatCard Grid.Column="6" Caption="{ui:T Due_Overdue}" Value="{Binding Overdue, StringFormat=N0}" Glyph="{x:Static ui:Icons.Warning}" Tint="{StaticResource WarningTintBrush}" Accent="{StaticResource DangerBrush}"/>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="20,4,20,0" ClipToBounds="True">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,14">
                        <Button Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}" Command="{Binding EditCommand}" Margin="0,0,10,0" MinWidth="110"><StackPanel Orientation="Horizontal"><ui:GlyphIcon Glyph="{x:Static ui:Icons.Edit}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="{ui:T Action_Edit}"/></StackPanel></Button>
                        <Button Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}" Command="{Binding OpeningCommand}" Margin="0,0,10,0" MinWidth="140"><TextBlock Text="{ui:T Sup_Opening}"/></Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding CollectCommand}" MinWidth="170"><TextBlock Text="{ui:T Cust_Collect}" FontWeight="SemiBold"/></Button>
                    </StackPanel>
                    <TabControl SelectedIndex="{Binding Tab}">
                        <TabItem Header="{ui:T Cust_TabPurchases}">
                            <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Invoices}" RowHeight="44" Margin="0,8,0,0" AutomationProperties.Name="Purchases">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{ui:T Col_Invoice}" Binding="{Binding Number}" Width="140" ElementStyle="{StaticResource Ltr}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Date}" Binding="{Binding DateText}" Width="*" ElementStyle="{StaticResource Ltr}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Payment}" Binding="{Binding Payment}" Width="140" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Total}" Binding="{Binding Total, StringFormat=N0}" Width="120" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource GridHeaderRight}"/>
                                    <DataGridTemplateColumn Header="{ui:T Col_Status}" Width="130">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ui:Badge Kind="{Binding StatusKind}" VerticalAlignment="Center"><TextBlock Text="{Binding Status}"/></ui:Badge></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource IconButtonSmall}" HorizontalAlignment="Center" Command="{Binding DataContext.ViewInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" AutomationProperties.Name="View invoice">
                                                    <ui:GlyphIcon Glyph="{x:Static ui:Icons.Eye}" FontSize="13"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="{ui:T Inst_Tab}">
                            <Grid>
                                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Installments}" RowHeight="46" Margin="0,8,0,0" AutomationProperties.Name="Installments">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{ui:T Col_Invoice}" Binding="{Binding Invoice}" Width="120" ElementStyle="{StaticResource Ltr}"/>
                                        <DataGridTextColumn Header="#" Binding="{Binding Seq}" Width="46" ElementStyle="{StaticResource Ltr}"/>
                                        <DataGridTextColumn Header="{ui:T Col_DueDate}" Binding="{Binding DueDate}" Width="120" ElementStyle="{StaticResource Ltr}"/>
                                        <DataGridTextColumn Header="{ui:T Inst_Amount}" Binding="{Binding Amount, StringFormat=N2}" Width="*" MinWidth="100" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource GridHeaderRight}"/>
                                        <DataGridTextColumn Header="{ui:T Col_Paid}" Binding="{Binding Paid, StringFormat=N2}" Width="100" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource GridHeaderRight}"/>
                                        <DataGridTextColumn Header="{ui:T Col_Remaining}" Binding="{Binding Remaining, StringFormat=N2}" Width="110" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource GridHeaderRight}"/>
                                        <DataGridTemplateColumn Header="{ui:T Col_Status}" Width="190">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:Badge Kind="{Binding StatusKind}"><TextBlock Text="{Binding Status}"/></ui:Badge>
                                                        <ui:Badge Kind="Danger" Margin="6,0,0,0" Visibility="{Binding Overdue, Converter={StaticResource BoolToVis}}"><TextBlock Text="{ui:T Due_Late}"/></ui:Badge>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Style="{StaticResource IconButtonSmall}" Command="{Binding DataContext.HistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" AutomationProperties.Name="Schedule history">
                                                            <ui:GlyphIcon Glyph="{x:Static ui:Icons.History}" FontSize="13"/>
                                                        </Button>
                                                        <Button Style="{StaticResource IconButtonSmall}" Margin="6,0,0,0" Visibility="{Binding CanReschedule, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.RescheduleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" AutomationProperties.Name="Reschedule">
                                                            <ui:GlyphIcon Glyph="{x:Static ui:Icons.Calendar}" FontSize="13"/>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ui:EmptyState Glyph="{x:Static ui:Icons.Calendar}" Title="{ui:T Inst_Empty}" Message="{ui:T Inst_EmptyMsg}" Visibility="{Binding HasInstallments, Converter={StaticResource InvBoolToVis}}"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{ui:T Cust_TabPayments}">
                            <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Collections}" RowHeight="46" Margin="0,8,0,0" AutomationProperties.Name="Payments">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{ui:T Col_Reference}" Binding="{Binding Number}" Width="110" ElementStyle="{StaticResource Ltr}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Date}" Binding="{Binding Date}" Width="110" ElementStyle="{StaticResource Ltr}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Payment}" Binding="{Binding MethodText}" Width="110" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Alloc}" Binding="{Binding Allocated}" Width="*" MinWidth="120" ElementStyle="{StaticResource Ltr}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Amount}" Binding="{Binding Amount, StringFormat=N2}" Width="110" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource GridHeaderRight}"/>
                                    <DataGridTemplateColumn Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <ui:Badge Kind="Neutral" Visibility="{Binding Reversed, Converter={StaticResource BoolToVis}}"><TextBlock Text="{ui:T Sup_Reversed}"/></ui:Badge>
                                                    <Button Style="{StaticResource IconButtonSmall}" Visibility="{Binding CanReverse, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.ReverseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" AutomationProperties.Name="Reverse payment">
                                                        <ui:GlyphIcon Glyph="{x:Static ui:Icons.History}" FontSize="13"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="{ui:T Cust_TabStatement}">
                            <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Statement}" RowHeight="44" Margin="0,8,0,0" AutomationProperties.Name="Statement">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{ui:T Col_Date}" Binding="{Binding Date}" Width="120" ElementStyle="{StaticResource Ltr}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Reference}" Binding="{Binding Document}" Width="140" ElementStyle="{StaticResource Ltr}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Type}" Binding="{Binding Type}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Amount}" Binding="{Binding Amount, StringFormat=N2}" Width="130" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource GridHeaderRight}"/>
                                    <DataGridTextColumn Header="{ui:T Cust_Running}" Binding="{Binding Running, StringFormat=N2}" Width="140" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource GridHeaderRight}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="{ui:T Loyalty_Title}">
                            <Grid DataContext="{Binding Loyalty}" Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><TextBlock Text="{ui:T Loyalty_Balance}" Style="{StaticResource H3}" VerticalAlignment="Center"/><TextBlock Text="{Binding Balance}" FontSize="24" FontWeight="Bold" FlowDirection="LeftToRight" Margin="20,0"/><Button Command="{Binding AdjustCommand}" Content="{ui:T Loyalty_Adjust}" Visibility="{Binding IsOwner,Converter={StaticResource BoolToVis}}"/></StackPanel>
                                <Grid Grid.Row="1" Margin="0,0,0,12" Visibility="{Binding IsOwner,Converter={StaticResource BoolToVis}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{ui:T Promo_Group}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Group,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><Button Grid.Column="2" Content="{ui:T Action_Save}" Command="{Binding SaveGroupCommand}" VerticalAlignment="Bottom"/></Grid>
                                <TextBlock Grid.Row="2" Text="{Binding Error}" Style="{StaticResource ErrorText}"/>
                                <DataGrid Grid.Row="3" ItemsSource="{Binding Entries}" Style="{StaticResource DataTable}" RowHeight="44"><DataGrid.Columns>
                                    <DataGridTextColumn Header="{ui:T Col_Date}" Binding="{Binding Date}" Width="170" ElementStyle="{StaticResource Ltr}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Type}" Binding="{Binding Kind}" Width="*"/>
                                    <DataGridTextColumn Header="{ui:T Loyalty_Points}" Binding="{Binding Points}" Width="120" ElementStyle="{StaticResource CellNumber}"/>
                                    <DataGridTextColumn Header="{ui:T Loyalty_Expires}" Binding="{Binding Expiry}" Width="140" ElementStyle="{StaticResource Ltr}"/>
                                </DataGrid.Columns></DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{ui:T Cust_TabStats}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                                <StackPanel>
                                    <WrapPanel>
                                        <WrapPanel.Resources>
                                            <Style x:Key="StatBox" TargetType="Border"><Setter Property="Width" Value="168"/><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="Padding" Value="14,10"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
                                        </WrapPanel.Resources>
                                        <Border Style="{StaticResource StatBox}"><StackPanel><TextBlock Text="{ui:T Cust_StatInvoices}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Stats.Invoices}" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/></StackPanel></Border>
                                        <Border Style="{StaticResource StatBox}"><StackPanel><TextBlock Text="{ui:T Cust_StatPurchases}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Stats.Purchases, StringFormat=N2}" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/></StackPanel></Border>
                                        <Border Style="{StaticResource StatBox}"><StackPanel><TextBlock Text="{ui:T Cust_StatReturns}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding ReturnsText}" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/></StackPanel></Border>
                                        <Border Style="{StaticResource StatBox}"><StackPanel><TextBlock Text="{ui:T Cust_StatNet}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Stats.Net, StringFormat=N2}" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left" Foreground="{StaticResource OrangeBrush}"/></StackPanel></Border>
                                        <Border Style="{StaticResource StatBox}"><StackPanel><TextBlock Text="{ui:T Cust_StatAverage}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Stats.AverageBasket, StringFormat=N2}" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/></StackPanel></Border>
                                        <Border Style="{StaticResource StatBox}"><StackPanel><TextBlock Text="{ui:T Cust_StatFirst}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding FirstPurchase}" FontSize="16" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/></StackPanel></Border>
                                        <Border Style="{StaticResource StatBox}"><StackPanel><TextBlock Text="{ui:T Cust_StatLast}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding LastPurchase}" FontSize="16" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/></StackPanel></Border>
                                    </WrapPanel>
                                    <TextBlock Text="{ui:T Cust_StatTop}" Style="{StaticResource H3}" Margin="0,6,0,8"/>
                                    <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Stats.TopItems}" RowHeight="40" MaxHeight="260" AutomationProperties.Name="Most bought items">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{ui:T Col_Item}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                            <DataGridTextColumn Header="{ui:T Col_Qty}" Binding="{Binding Quantity, StringFormat=0.###}" Width="100" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource GridHeaderRight}"/>
                                            <DataGridTextColumn Header="{ui:T Col_Total}" Binding="{Binding Spent, StringFormat=N2}" Width="130" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource GridHeaderRight}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="{ui:T Cust_StatNone}" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="{Binding HasNoPurchases, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
