<UserControl x:Class="Dukkan.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Dukkan.UI">
    <Grid Margin="24,12,24,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <TextBlock Text="{ui:T Nav_Dashboard}" Style="{StaticResource H1}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Style="{StaticResource FlatCard}" Height="38" Padding="12,0" CornerRadius="8" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:GlyphIcon Glyph="{x:Static ui:Icons.Calendar}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DateText}" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}" Width="150" AutomationProperties.Name="Date range"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:StatCard Caption="{ui:T Dash_TotalSales}" Value="{Binding TotalSales, StringFormat=N0}" Delta="{Binding SalesDelta.Text}" DeltaKind="{Binding SalesDelta.Kind}" Glyph="{x:Static ui:Icons.Cart}"
                         Tint="{StaticResource SuccessTintBrush}" Accent="{StaticResource SuccessBrush}"/>
            <ui:StatCard Grid.Column="2" Caption="{ui:T Dash_Invoices}" Value="{Binding Invoices, StringFormat=N0}" Delta="{Binding InvoicesDelta.Text}" DeltaKind="{Binding InvoicesDelta.Kind}" Glyph="{x:Static ui:Icons.Document}"
                         Tint="{StaticResource InfoTintBrush}" Accent="{StaticResource NavyLightBrush}"/>
            <ui:StatCard Grid.Column="4" Caption="{ui:T Dash_ItemsSold}" Value="{Binding ItemsSold, StringFormat=N0}" Delta="{Binding ItemsDelta.Text}" DeltaKind="{Binding ItemsDelta.Kind}" Glyph="{x:Static ui:Icons.Bag}"
                         Tint="{StaticResource OrangeTintBrush}" Accent="{StaticResource OrangeBrush}"/>
            <ui:StatCard Grid.Column="6" Caption="{ui:T Dash_GrossProfit}" Value="{Binding GrossProfit, StringFormat=N0}" Delta="{Binding ProfitDelta.Text}" DeltaKind="{Binding ProfitDelta.Kind}" Glyph="{x:Static ui:Icons.Chart}"
                         Tint="{StaticResource SuccessTintBrush}" Accent="{StaticResource SuccessBrush}"/>
            <ContentControl Grid.ColumnSpan="7" Style="{StaticResource LoadingOverlay}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="22,18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding TrendTitle}" Style="{StaticResource H3}" Margin="0,0,0,8"/>
                    <ui:BarChart Items="{Binding Trend}" BarBrush="{StaticResource OrangeBrush}" FlowDirection="LeftToRight" MinHeight="180"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{ui:T Dash_TopCategories}" Style="{StaticResource H3}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Categories}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Style="{StaticResource ThinProgress}" Value="{Binding Percent, Mode=OneWay}" Maximum="100" Margin="4,0,12,0" FlowDirection="LeftToRight"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PercentText}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FlowDirection="LeftToRight"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
            <ContentControl Grid.ColumnSpan="3" Style="{StaticResource LoadingOverlay}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</UserControl>
