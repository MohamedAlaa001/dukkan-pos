<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Dukkan.UI">
    <DataTemplate DataType="{x:Type ui:GlobalSearchViewModel}">
        <Border Style="{StaticResource DialogCard}" Width="{Binding Width}">
            <StackPanel>
                <ContentPresenter ContentTemplate="{StaticResource DialogHeaderTemplate}" Content="{ui:T Search_Choose}"/>
                <TextBlock Text="{Binding Query}" TextWrapping="Wrap" Margin="0,0,0,16" FontWeight="SemiBold"/>
                <Button Content="{ui:T Nav_Products}" Command="{Binding ProductsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,10"/>
                <Button Content="{ui:T Nav_Customers}" Command="{Binding CustomersCommand}" Margin="0,0,0,10"/>
                <Button Content="{ui:T Rep_TabHistory}" Command="{Binding InvoicesCommand}" Margin="0,0,0,10"
                        Visibility="{Binding CanSearchInvoices, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{ui:T Search_InvoiceRange}" TextWrapping="Wrap" Style="{StaticResource Caption}"
                           Visibility="{Binding CanSearchInvoices, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
