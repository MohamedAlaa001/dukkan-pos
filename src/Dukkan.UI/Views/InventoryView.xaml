<UserControl x:Class="Dukkan.UI.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Dukkan.UI"
             xmlns:v="clr-namespace:Dukkan.UI.Views">
    <Grid Margin="24,12,24,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <TextBlock Text="{ui:T Inv_Title}" Style="{StaticResource H1}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding AdjustCommand}" HorizontalAlignment="Right" MinWidth="170">
                <StackPanel Orientation="Horizontal"><ui:GlyphIcon Glyph="{x:Static ui:Icons.Add}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{ui:T Inv_NewMovement}" FontWeight="SemiBold"/></StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,4,20,0" ClipToBounds="True">
            <TabControl>
                <TabItem Header="{ui:T Inv_TabMovements}">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" Width="170" Margin="0,0,12,0" AutomationProperties.Name="Movement type"/>
                            <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}" Width="190" AutomationProperties.Name="Date range"/>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource FlatCard}" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Pager.Items}" RowHeight="46" AutomationProperties.Name="Inventory movements">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding No}" Width="56" ElementStyle="{StaticResource Ltr}"/>
                                        <DataGridTextColumn Header="{ui:T Col_Date}" Binding="{Binding DateText}" Width="130" ElementStyle="{StaticResource Ltr}"/>
                                        <DataGridTemplateColumn Header="{ui:T Col_Type}" Width="150">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ui:Badge Kind="{Binding TypeKind}" VerticalAlignment="Center"><TextBlock Text="{Binding Type}"/></ui:Badge></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{ui:T Col_Product}" Binding="{Binding Product}" Width="*" MinWidth="200" ElementStyle="{StaticResource CellText}"/>
                                        <DataGridTemplateColumn Header="{ui:T Col_Qty}" Width="90" HeaderStyle="{StaticResource GridHeaderRight}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding QtyText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" FlowDirection="LeftToRight">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                <Style.Triggers><DataTrigger Binding="{Binding IsIncrease}" Value="True"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{ui:T Col_Reference}" Binding="{Binding Reference}" Width="150" ElementStyle="{StaticResource Ltr}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <ui:EmptyState Glyph="{x:Static ui:Icons.History}" Title="{ui:T Empty_NoMovements}" Message="{ui:T Empty_NoMovementsMsg}" Visibility="{Binding Pager.TotalCount, Converter={StaticResource CountToVis}}"/>
                                <v:PaginationBar Grid.Row="1" DataContext="{Binding Pager}"/>
                                <ContentControl Grid.RowSpan="2" Style="{StaticResource LoadingOverlay}" Visibility="{Binding DataContext.IsLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="{ui:T Inv_TabLevels}">
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{ui:T Count_Hint}" Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap" TextTrimming="None"/>
                        <Border Grid.Row="1" Style="{StaticResource FlatCard}" ClipToBounds="True">
                            <Grid>
                                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Levels}" RowHeight="52" AutomationProperties.Name="Stock levels">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{ui:T Col_Product}" Width="*" MinWidth="220">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Style="{StaticResource ThumbTile}" Width="36" Height="36" Padding="5" Margin="0,0,12,0"><ui:GarmentThumb Kind="{Binding Variant.Kind}" Image="{Binding Image}" Foreground="{Binding Variant.ColorHex, Converter={StaticResource HexBrush}}"/></Border>
                                                        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Variant.StyleName}" FontWeight="Medium"/><TextBlock Text="{Binding Variant.Label}" Style="{StaticResource Caption}"/></StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{ui:T Col_Sku}" Binding="{Binding Variant.Sku}" Width="170" ElementStyle="{StaticResource Ltr}"/>
                                        <DataGridTemplateColumn Header="{ui:T Col_Stock}" Width="*" MinWidth="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                                                        <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Variant.Fill, Mode=OneWay}" FlowDirection="LeftToRight" Margin="0,0,10,0">
                                                            <ProgressBar.Resources>
                                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource ThinProgress}">
                                                                    <Style.Triggers><DataTrigger Binding="{Binding IsCritical}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </ProgressBar.Resources>
                                                        </ProgressBar>
                                                        <TextBlock Grid.Column="1" Text="{Binding Variant.Stock}" HorizontalAlignment="Right" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{ui:T Col_Status}" Width="130">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ui:Badge Kind="{Binding StatusKind}" VerticalAlignment="Center"><TextBlock Text="{Binding Status}"/></ui:Badge></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{ui:T Col_Counted}" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><TextBox Text="{Binding Counted, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Width="90" TextAlignment="Center" FlowDirection="LeftToRight" AutomationProperties.Name="Counted quantity"/></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,14">
                            <TextBlock Text="{ui:T Inv_Reason}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Medium"/>
                            <TextBox Text="{Binding CountReason, UpdateSourceTrigger=PropertyChanged}" Width="280" AutomationProperties.Name="Count reason"/>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding PostCountCommand}" Content="{ui:T Count_Post}" Margin="12,0,0,0" MinWidth="150"/>
                            <TextBlock Text="{Binding CountError}" Style="{StaticResource ErrorText}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
