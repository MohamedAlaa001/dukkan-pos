<UserControl x:Class="Dukkan.UI.Views.ProductEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Dukkan.UI">
    <Grid Margin="24,12,24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <TextBlock Text="{ui:T Prod_Details}" Style="{StaticResource H1}" Margin="0,0,0,10"/>

        <!-- Breadcrumb -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Style="{StaticResource IconButton}" Command="{Binding CancelCommand}" Width="32" Height="32" MinHeight="32" Margin="0,0,6,0" AutomationProperties.Name="Back to products">
                <ui:GlyphIcon Glyph="{Binding BackGlyph, Source={x:Static ui:Localizer.Instance}}" FontSize="14"/>
            </Button>
            <TextBlock Text="{ui:T Nav_Products}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            <ui:GlyphIcon Glyph="{Binding NextGlyph, Source={x:Static ui:Localizer.Instance}}" FontSize="10" Foreground="{StaticResource PlaceholderBrush}" Margin="10,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Crumb}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            <ui:GlyphIcon Glyph="{Binding NextGlyph, Source={x:Static ui:Localizer.Instance}}" FontSize="10" Foreground="{StaticResource PlaceholderBrush}" Margin="10,0" VerticalAlignment="Center"/>
            <TextBlock Text="{ui:T Action_Edit}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="318"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- Product image preview and color gallery. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="0" Height="268">
                        <Border Style="{StaticResource ThumbTile}" CornerRadius="10" Padding="34" Margin="0">
                            <ui:GarmentThumb Kind="{Binding PreviewKind}" Image="{Binding Image}" Foreground="{Binding PreviewHex, Converter={StaticResource HexBrush}}"/>
                        </Border>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Gallery}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ProductCardButton}" Width="92" Height="92" Margin="0,0,8,8" Command="{Binding DataContext.SelectGalleryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding ColorName}">
                                    <Border Style="{StaticResource ThumbTile}" Padding="6">
                                        <ui:GarmentThumb Kind="{Binding DataContext.PreviewKind, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Foreground="{Binding ColorHex, Converter={StaticResource HexBrush}}"/>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Width="92" Height="92" HorizontalAlignment="Left" Command="{Binding AddImageCommand}" Margin="0,0,0,8" AutomationProperties.Name="Add image">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="Ring" Margin="-2" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource FocusRingBrush}" Visibility="Collapsed"/>
                                    <Border x:Name="Bd" CornerRadius="10" BorderThickness="1.5" BorderBrush="{StaticResource PlaceholderBrush}" Background="Transparent">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <ui:GlyphIcon Glyph="{x:Static ui:Icons.Add}" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{ui:T Prod_AddImage}" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource OrangeBrush}"/></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Command="{Binding RemoveImageCommand}" Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" MinWidth="92" Height="30" MinHeight="30" Margin="0,0,0,8">
                        <TextBlock Text="{ui:T Prod_RemoveImage}" FontSize="12"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Form -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24,6,24,0">
                <TabControl SelectedIndex="{Binding Tab, Mode=TwoWay}">
                    <!-- General -->
                    <TabItem Header="{ui:T Tab_General}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,18,8,18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{ui:T Field_ProductName}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Product name"/>
                                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[Name]}"/>

                                    <TextBlock Text="{ui:T Field_NameAlt}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                                    <TextBox Text="{Binding NameAlt, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Arabic name"/>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.ColumnSpan="3">
                                            <TextBlock Text="{ui:T Col_Category}" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" AutomationProperties.Name="Category"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Visibility="Collapsed">
                                            <TextBlock Text="{ui:T Field_Kind}" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" AutomationProperties.Name="Garment type"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{ui:T Field_Unit}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                                    <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" AutomationProperties.Name="Unit"/>

                                    <TextBlock Text="{ui:T Field_Brand}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                                    <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Brand"/>

                                    <TextBlock Text="{ui:T Field_Description}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" Padding="10,8" VerticalContentAlignment="Top" AutomationProperties.Name="Description"/>

                                    <Border Background="{StaticResource InfoTintBrush}" CornerRadius="8" Padding="14,10" Margin="0,16,0,0">
                                        <TextBlock Text="{ui:T Field_SkuNote}" TextWrapping="Wrap" TextTrimming="None" Foreground="{StaticResource NavyBrush}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{ui:T Field_BasePrice}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding BasePrice, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="Base price"/>
                                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[BasePrice]}"/>
                                    <TextBlock Text="{ui:T Field_CostPrice}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                                    <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="Cost price"/>
                                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[CostPrice]}"/>
                                    <TextBlock Text="{ui:T Field_LowStock}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                                    <TextBox Text="{Binding LowStockAlert, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="Low stock alert"/>
                                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[LowStockAlert]}"/>
                                    <TextBlock Text="{ui:T Col_Status}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" AutomationProperties.Name="Status"/>
                                    <CheckBox Style="{StaticResource SwitchStyle}" IsChecked="{Binding TrackInventory}" Content="{ui:T Field_Track}" Margin="0,22,0,0"/>
                                    <CheckBox Style="{StaticResource SwitchStyle}" IsChecked="{Binding AllowDiscount}" Content="{ui:T Field_AllowDiscount}" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Variants: size and colour selectors -->
                    <TabItem Header="{ui:T Tab_Variants}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,18,8,18">
                            <StackPanel>
                                <TextBlock Text="{ui:T Var_NoOptions}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,8" Visibility="{Binding NoOptions, Converter={StaticResource BoolToVis}}"/>
                                <StackPanel Visibility="{Binding HasOption1, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Option1Name}" Style="{StaticResource FieldLabel}"/>
                                <ItemsControl ItemsSource="{Binding Sizes}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource SizeChip}" Content="{Binding Size}" IsChecked="{Binding IsSelected}" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding Size}"
                                                          IsEnabled="{Binding Locked, Converter={StaticResource InvBool}}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,6,0,0" MaxWidth="360" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewSize, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" ui:Ui.Placeholder="{ui:T Var_AddValue}" AutomationProperties.Name="New value">
                                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddSizeCommand}"/></TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="2" Command="{Binding AddSizeCommand}" MinHeight="34" Content="{ui:T Var_Add}"/>
                                </Grid>
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasOption2, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Option2Name}" Style="{StaticResource FieldLabel}" Margin="0,14,0,8"/>
                                <ItemsControl ItemsSource="{Binding Colors}" Visibility="{Binding Option2IsColor, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource ColorSwatch}" IsChecked="{Binding IsSelected}" Background="{Binding Hex, Converter={StaticResource HexBrush}}"
                                                          Foreground="{Binding Contrast, Converter={StaticResource HexBrush}}" ToolTip="{Binding Option.Name}" AutomationProperties.Name="{Binding Option.Name}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding Colors}" Visibility="{Binding Option2IsText, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource SizeChip}" Content="{Binding Option.Name}" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Option.Name}"
                                                          IsEnabled="{Binding Locked, Converter={StaticResource InvBool}}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,6,0,0" MaxWidth="360" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewColor, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" ui:Ui.Placeholder="{ui:T Var_AddValue}" AutomationProperties.Name="New value">
                                        <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddColorCommand}"/></TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="2" Command="{Binding AddColorCommand}" MinHeight="34" Content="{ui:T Var_Add}"/>
                                </Grid>
                                </StackPanel>
                                <TextBlock Text="{ui:T Var_LockedNote}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="None"/>

                                <Grid Margin="0,14,0,10">
                                    <TextBlock Text="{ui:T Var_Generated}" Style="{StaticResource H3}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource Caption}"><Run Text="{ui:T Var_Total}"/><Run Text=": "/><Run Text="{Binding TotalStock, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                                </Grid>
                                <Border Style="{StaticResource FlatCard}" ClipToBounds="True" Visibility="{Binding VariantsEmpty, Converter={StaticResource InvBoolToVis}}">
                                    <StackPanel>
                                        <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Height="38" Padding="14,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DataContext.Option2Name, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DataContext.Option1Name, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{ui:T Col_Sku}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{ui:T Field_Barcode}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{ui:T Col_Stock}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Variants}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,6" MinHeight="46">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse Width="16" Height="16" Fill="{Binding ColorHex, Converter={StaticResource HexBrush}}" Stroke="#33000000" Margin="0,0,10,0" Visibility="{Binding HasColor, Converter={StaticResource BoolToVis}}"/>
                                                                <TextBlock Text="{Binding ColorName}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Size}" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                        <Setter Property="Text" Value="{Binding Sku}"/>
                                                                        <Style.Triggers><DataTrigger Binding="{Binding IsNew}" Value="True"><Setter Property="Text" Value="{Binding Source={x:Static ui:Localizer.Instance}, Path=[Var_Auto]}"/></DataTrigger></Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="3" Text="{Binding Barcode}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                                            <TextBox Grid.Column="4" Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}" Width="80" MinHeight="32" HorizontalAlignment="Right" TextAlignment="Right" FlowDirection="LeftToRight" AutomationProperties.Name="Stock"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <ui:EmptyState Glyph="{x:Static ui:Icons.Tag}" Title="{ui:T Var_EmptyTitle}" Message="{ui:T Var_EmptyMsg}" Visibility="{Binding VariantsEmpty, Converter={StaticResource BoolToVis}}"/>
                                <Button Command="{Binding PrintLabelsCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" MinHeight="38" Visibility="{Binding IsNew, Converter={StaticResource InvBoolToVis}}">
                                    <StackPanel Orientation="Horizontal"><ui:GlyphIcon Glyph="{x:Static ui:Icons.Print}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="{ui:T Label_Print}"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Inventory -->
                    <TabItem Header="{ui:T Tab_Inventory}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,18,8,18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <ui:StatCard Caption="{ui:T Var_Total}" Value="{Binding TotalStock}" Glyph="{x:Static ui:Icons.Package}" Tint="{StaticResource OrangeTintBrush}" Accent="{StaticResource OrangeBrush}"/>
                                    <ui:StatCard Grid.Column="2" Caption="{ui:T Var_Generated}" Value="{Binding Variants.Count}" Glyph="{x:Static ui:Icons.Tag}" Tint="{StaticResource InfoTintBrush}" Accent="{StaticResource NavyLightBrush}"/>
                                    <ui:StatCard Grid.Column="4" Caption="{ui:T Field_LowStock}" Value="{Binding LowStockAlert}" Glyph="{x:Static ui:Icons.Warning}" Tint="{StaticResource WarningTintBrush}" Accent="{StaticResource WarningTextBrush}"/>
                                </Grid>
                                <CheckBox Style="{StaticResource SwitchStyle}" IsChecked="{Binding TrackInventory}" Content="{ui:T Field_Track}" Margin="0,22,0,0"/>
                                <TextBlock Text="{ui:T Inv_TabNote}" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Pricing -->
                    <TabItem Header="{ui:T Tab_Pricing}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,18,8,18">
                            <StackPanel MaxWidth="420" HorizontalAlignment="Left">
                                <TextBlock Text="{ui:T Field_BasePrice}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding BasePrice, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="Base price"/>
                                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[BasePrice]}"/>
                                <TextBlock Text="{ui:T Field_CostPrice}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                                <TextBox Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="Cost price"/>
                                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[CostPrice]}"/>
                                <TextBlock Text="{ui:T Field_Tax}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                                <TextBox Text="{Binding TaxPercent, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Width="140" HorizontalAlignment="Left" AutomationProperties.Name="Tax rate"/>
                                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[TaxPercent]}"/>
                                <Border Background="{StaticResource SuccessTintBrush}" CornerRadius="10" Padding="16,14" Margin="0,20,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{ui:T Price_Margin}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Margin}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessTextBrush}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{ui:T Price_Profit}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Profit, Converter={StaticResource MoneyConv}}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessTextBrush}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/></StackPanel>
                                    </Grid>
                                </Border>
                                <CheckBox Style="{StaticResource SwitchStyle}" IsChecked="{Binding AllowDiscount}" Content="{ui:T Field_AllowDiscount}" Margin="0,22,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Footer actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{ui:T Action_Cancel}" Command="{Binding CancelCommand}" MinWidth="120" MinHeight="42" Margin="0,0,10,0" FontWeight="SemiBold"/>
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" MinWidth="160" MinHeight="42" Content="{ui:T Action_SaveChanges}"/>
        </StackPanel>
    </Grid>
</UserControl>
