<UserControl x:Class="Dukkan.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Dukkan.UI" xmlns:views="clr-namespace:Dukkan.UI.Views">
    <Grid Margin="24,12,24,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="{ui:T Nav_Settings}" Style="{StaticResource H1}" Margin="0,0,0,14"/>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="24,6,24,0" ClipToBounds="True">
            <TabControl SelectedIndex="{Binding Tab, Mode=TwoWay}">

                <!-- Store and receipts -->
                <TabItem Header="{ui:T Set_TabStore}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,18,8,18">
                        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="{ui:T Set_StoreName}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Store name"/>
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[StoreName]}"/>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{ui:T Col_Phone}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding StorePhone, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Icon="{x:Static ui:Icons.Phone}" FlowDirection="LeftToRight" AutomationProperties.Name="Phone"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="{ui:T Set_Address}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding StoreAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Address"/></StackPanel>
                            </Grid>
                            <TextBlock Text="{ui:T Set_Footer}" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                            <TextBox Text="{Binding ReceiptFooter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Receipt footer"/>
                            <TextBlock Text="{ui:T Set_ReceiptLanguage}" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="rlang" Style="{StaticResource ChipRadio}" Content="English" IsChecked="{Binding ReceiptEnglish}" FlowDirection="LeftToRight" MinWidth="110"/>
                                <RadioButton GroupName="rlang" Style="{StaticResource ChipRadio}" Content="العربية" IsChecked="{Binding ReceiptArabic}" MinWidth="110"/>
                            </StackPanel>
                            <Border Background="{StaticResource InfoTintBrush}" CornerRadius="8" Padding="14,10" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="{ui:T Set_TaxMode}" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
                                    <TextBlock Text="{Binding TaxModeText}" Foreground="{StaticResource NavyBrush}"/>
                                    <TextBlock Text="{ui:T Set_TaxLocked}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{ui:T Setup_TaxRate}" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                            <TextBox Text="{Binding TaxPercent, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" FlowDirection="LeftToRight" AutomationProperties.Name="Default tax rate"/>
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[TaxPercent]}"/>
                            <CheckBox Style="{StaticResource SwitchStyle}" IsChecked="{Binding AutoPrint}" Content="{ui:T Set_PrintReceipts}" Margin="0,18,0,0"/>
                            <CheckBox Style="{StaticResource SwitchStyle}" IsChecked="{Binding StartWithWindows}" Content="{ui:T Set_StartWithWindows}" Margin="0,12,0,0"/>
                            <CheckBox Style="{StaticResource SwitchStyle}" IsChecked="{Binding StartFullScreen}" Content="{ui:T Set_StartFullScreen}" Margin="0,12,0,0"/>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveStoreCommand}" Content="{ui:T Action_SaveChanges}" HorizontalAlignment="Left" MinWidth="160" MinHeight="42" Margin="0,22,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Printers -->
                <!-- Catalog: shop type, product options, categories -->
                <TabItem Header="{ui:T Set_TabCatalog}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,18,8,18" DataContext="{Binding Catalog}">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="{ui:T Cat_Presets}" Style="{StaticResource H3}"/>
                            <TextBlock Text="{ui:T Cat_PresetsNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,10"/>
                            <WrapPanel>
                                <Button Command="{Binding PresetCommand}" CommandParameter="general" Content="{ui:T Biz_general}" Margin="0,0,8,8" MinHeight="36"/>
                                <Button Command="{Binding PresetCommand}" CommandParameter="clothing" Content="{ui:T Biz_clothing}" Margin="0,0,8,8" MinHeight="36"/>
                                <Button Command="{Binding PresetCommand}" CommandParameter="grocery" Content="{ui:T Biz_grocery}" Margin="0,0,8,8" MinHeight="36"/>
                                <Button Command="{Binding PresetCommand}" CommandParameter="pharmacy" Content="{ui:T Biz_pharmacy}" Margin="0,0,8,8" MinHeight="36"/>
                                <Button Command="{Binding PresetCommand}" CommandParameter="electronics" Content="{ui:T Biz_electronics}" Margin="0,0,8,8" MinHeight="36"/>
                                <Button Command="{Binding PresetCommand}" CommandParameter="beauty" Content="{ui:T Biz_beauty}" Margin="0,0,8,8" MinHeight="36"/>
                                <Button Command="{Binding PresetCommand}" CommandParameter="home" Content="{ui:T Biz_home}" Margin="0,0,8,8" MinHeight="36"/>
                                <Button Command="{Binding PresetCommand}" CommandParameter="toys" Content="{ui:T Biz_toys}" Margin="0,0,8,8" MinHeight="36"/>
                            </WrapPanel>

                            <TextBlock Text="{ui:T Cat_Options}" Style="{StaticResource H3}" Margin="0,18,0,0"/>
                            <TextBlock Text="{ui:T Cat_OptionsNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{ui:T Cat_Option1}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Option1Name, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{ui:T Cat_OptionNamePh}" AutomationProperties.Name="First option name"/>
                                    <TextBlock Text="{ui:T Cat_Suggestions}" Style="{StaticResource FieldLabel}" Margin="0,10,0,6"/>
                                    <TextBox Text="{Binding Option1Values, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="First option values"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{ui:T Cat_Option2}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Option2Name, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{ui:T Cat_OptionNamePh}" AutomationProperties.Name="Second option name"/>
                                    <TextBlock Text="{ui:T Cat_Suggestions}" Style="{StaticResource FieldLabel}" Margin="0,10,0,6"/>
                                    <TextBox Text="{Binding Option2Values, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Second option values"/>
                                    <CheckBox Content="{ui:T Cat_IsColor}" IsChecked="{Binding Option2IsColor}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Content="{ui:T Action_Save}" HorizontalAlignment="Left" MinWidth="140" Margin="0,14,0,0"/>

                            <TextBlock Text="{ui:T Cat_Categories}" Style="{StaticResource H3}" Margin="0,24,0,8"/>
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding DataContext.IconChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}" SelectedValue="{Binding Icon}" SelectedValuePath="Name" MinHeight="36" AutomationProperties.Name="Category picture">
                                                <ComboBox.ItemTemplate><DataTemplate><Image Source="{Binding Image}" Width="28" Height="28"/></DataTemplate></ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" AutomationProperties.Name="Category name"/>
                                            <TextBox Grid.Column="4" Text="{Binding NameAlt, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" ui:Ui.Placeholder="{ui:T Cat_ArabicName}" AutomationProperties.Name="Category Arabic name"/>
                                            <Button Grid.Column="6" Content="{ui:T Action_Save}" MinHeight="36" Margin="0,0,6,0" Command="{Binding DataContext.SaveCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            <Button Grid.Column="7" MinHeight="36" Content="{Binding ToggleText}" Command="{Binding DataContext.ToggleCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            <Button Grid.Column="8" MinHeight="36" Margin="6,0,0,0" Content="{ui:T Cat_Delete}" Foreground="{StaticResource DangerTextBrush}" Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{ui:T Cat_NoneYet}" Style="{StaticResource Caption}" Margin="0,0,0,8" Visibility="{Binding HasNoCategories, Converter={StaticResource BoolToVis}}"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding IconChoices}" SelectedValue="{Binding NewCategoryIcon}" SelectedValuePath="Name" MinHeight="36" AutomationProperties.Name="New category picture">
                                    <ComboBox.ItemTemplate><DataTemplate><Image Source="{Binding Image}" Width="28" Height="28"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Grid.Column="2" Text="{Binding NewCategory, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" ui:Ui.Placeholder="{ui:T Cat_NewName}" AutomationProperties.Name="New category"/>
                                <TextBox Grid.Column="4" Text="{Binding NewCategoryAlt, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" ui:Ui.Placeholder="{ui:T Cat_ArabicName}" AutomationProperties.Name="New category Arabic name"/>
                                <Button Grid.Column="6" Command="{Binding AddCategoryCommand}" Content="{ui:T Var_Add}" MinHeight="36" MinWidth="90"/>
                            </Grid>
                            <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{ui:T Set_TabPrinting}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,18,8,18">
                        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="{ui:T Set_PrintingNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,14"/>
                            <TextBlock Text="{ui:T Set_ReceiptPrinter}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding ReceiptPrinter}" AutomationProperties.Name="Receipt printer"/>
                            <TextBlock Text="{ui:T Set_A4Printer}" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                            <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding A4Printer}" AutomationProperties.Name="A4 printer"/>
                            <TextBlock Text="{ui:T Set_LabelPrinter}" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                            <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding LabelPrinter}" AutomationProperties.Name="Label printer"/>
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SavePrintingCommand}" Content="{ui:T Action_Save}" MinWidth="120" MinHeight="42" Margin="0,0,10,0"/>
                                <Button Command="{Binding RefreshPrintersCommand}" Content="{ui:T Action_Refresh}" MinHeight="42" Margin="0,0,10,0"/>
                                <Button Command="{Binding TestReceiptCommand}" Content="{ui:T Set_TestReceipt}" MinHeight="42" Margin="0,0,10,0"/>
                                <Button Command="{Binding TestLabelCommand}" Content="{ui:T Set_TestLabel}" MinHeight="42"/>
                            </StackPanel>
                            <Border CornerRadius="8" Padding="14,10" Margin="0,14,0,0" Visibility="{Binding HasPrintMessage, Converter={StaticResource BoolToVis}}" Background="{StaticResource InfoTintBrush}">
                                <TextBlock Text="{Binding PrintMessage}" TextWrapping="Wrap" TextTrimming="None" FontWeight="Medium"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Users -->
                <TabItem Header="{ui:T Set_TabUsers}">
                    <Grid Margin="0,14,0,14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddUserCommand}" MinHeight="40" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal"><ui:GlyphIcon Glyph="{x:Static ui:Icons.Add}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{ui:T User_Add}"/></StackPanel>
                            </Button>
                            <Button Command="{Binding ChangeMyPasswordCommand}" Content="{ui:T User_ChangeMine}" MinHeight="40" Margin="0,0,10,0"/>
                            <Button Command="{Binding NewRecoveryCodesCommand}" Content="{ui:T Rec_Generate}" MinHeight="40"/>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource FlatCard}" ClipToBounds="True">
                            <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Users}" RowHeight="50" AutomationProperties.Name="Users">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{ui:T Col_Name}" Binding="{Binding DisplayName}" Width="*" MinWidth="150" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="{ui:T Login_Username}" Binding="{Binding Username}" Width="160" ElementStyle="{StaticResource Ltr}"/>
                                    <DataGridTextColumn Header="{ui:T User_Role}" Binding="{Binding RoleText}" Width="120" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTemplateColumn Header="{ui:T Col_Status}" Width="120">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ui:Badge Kind="{Binding StatusKind}" VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}"/></ui:Badge></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="280">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource GhostButton}" MinHeight="32" Padding="10,0" Content="{ui:T User_ResetPassword}"
                                                            Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource GhostButton}" MinHeight="32" Padding="10,0" Foreground="{StaticResource DangerBrush}"
                                                            Command="{Binding DataContext.ToggleUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                    <Setter Property="Text" Value="{Binding Source={x:Static ui:Localizer.Instance}, Path=[User_Deactivate]}"/>
                                                                    <Style.Triggers><DataTrigger Binding="{Binding Active}" Value="False"><Setter Property="Text" Value="{Binding Source={x:Static ui:Localizer.Instance}, Path=[User_Activate]}"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Backup and restore -->
                <TabItem Header="{ui:T Set_TabBackup}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,18,8,18">
                        <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                            <Border Background="{StaticResource InfoTintBrush}" CornerRadius="10" Padding="16,12">
                                <TextBlock Text="{Binding BackupStatus}" TextWrapping="Wrap" TextTrimming="None" FontWeight="Medium" Foreground="{StaticResource NavyBrush}"/>
                            </Border>
                            <TextBlock Text="{ui:T bk_secret_title}" Style="{StaticResource H3}" Margin="0,18,0,4"/>
                            <TextBlock Text="{ui:T bk_secret_note}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <PasswordBox ui:Ui.Password="{Binding Secret1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{ui:T Setup_SecretPh}" AutomationProperties.Name="Recovery secret"/>
                                <PasswordBox Grid.Column="2" ui:Ui.Password="{Binding Secret2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{ui:T Setup_SecretConfirmPh}" AutomationProperties.Name="Confirm recovery secret"/>
                            </Grid>
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[Secret1]}"/>
                            <Button Command="{Binding SaveSecretCommand}" Content="{ui:T bk_save_secret}" HorizontalAlignment="Left" MinHeight="40" Margin="0,10,0,0"/>

                            <TextBlock Text="{ui:T bk_dir_label}" Style="{StaticResource H3}" Margin="0,22,0,6"/>
                            <TextBox Text="{Binding ExternalDir, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ui:Ui.Placeholder="E:\DukkanBackups" AutomationProperties.Name="External backup folder"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Command="{Binding SaveDirCommand}" Content="{ui:T bk_save_dir}" MinHeight="40" Margin="0,0,10,0"/>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding BackupNowCommand}" Content="{ui:T bk_now}" MinHeight="40" MinWidth="150"/>
                            </StackPanel>

                            <TextBlock Text="{ui:T bk_restore_title}" Style="{StaticResource H3}" Margin="0,26,0,4"/>
                            <TextBlock Text="{ui:T bk_restore_note}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,10"/>
                            <TextBox Text="{Binding RestorePath, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ui:Ui.Placeholder="E:\DukkanBackups\LocalCashier-….lcbk" AutomationProperties.Name="Backup package path"/>
                            <PasswordBox ui:Ui.Password="{Binding RestoreSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{ui:T Setup_SecretPh}" Margin="0,8,0,0" AutomationProperties.Name="Restore secret"/>
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[RestorePath]}"/>
                            <Button Style="{StaticResource DangerOutlineButton}" Command="{Binding RestoreCommand}" Content="{ui:T bk_restore}" HorizontalAlignment="Left" MinHeight="40" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Activity (audit) -->
                <TabItem Header="{ui:T Set_TabActivity}">
                    <Grid Margin="0,14,0,14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBox Text="{Binding AuditFilter, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Icon="{x:Static ui:Icons.Search}" ui:Ui.Placeholder="{ui:T Act_FilterPh}" Width="320" FlowDirection="LeftToRight" AutomationProperties.Name="Filter activity"/>
                            <Button Command="{Binding ReloadAuditCommand}" Content="{ui:T Action_Refresh}" MinHeight="38" Margin="10,0,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource FlatCard}" ClipToBounds="True">
                            <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Audit}" RowHeight="42" AutomationProperties.Name="Activity log">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{ui:T Col_Date}" Binding="{Binding When}" Width="120" ElementStyle="{StaticResource Ltr}"/>
                                    <DataGridTextColumn Header="{ui:T Act_Who}" Binding="{Binding Actor}" Width="150" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="{ui:T Act_Approver}" Binding="{Binding Approver}" Width="130" ElementStyle="{StaticResource CellMuted}"/>
                                    <DataGridTextColumn Header="{ui:T Act_Action}" Binding="{Binding Action}" Width="190" ElementStyle="{StaticResource Ltr}"/>
                                    <DataGridTextColumn Header="{ui:T Act_Target}" Binding="{Binding Target}" Width="*" ElementStyle="{StaticResource Ltr}"/>
                                    <DataGridTextColumn Header="{ui:T Inv_Reason}" Binding="{Binding Reason}" Width="*" ElementStyle="{StaticResource CellMuted}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Language and about -->
                <TabItem Header="{ui:T Set_TabAbout}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,18,8,18">
                        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock Text="{ui:T Set_Language}" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="lang" Style="{StaticResource ChipRadio}" Content="English" IsChecked="{Binding IsEnglish}" FlowDirection="LeftToRight" MinWidth="120"/>
                                <RadioButton GroupName="lang" Style="{StaticResource ChipRadio}" Content="العربية" IsChecked="{Binding IsArabic}" MinWidth="120"/>
                            </StackPanel>
                            <TextBlock Text="{ui:T Set_LanguageNote}" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="None"/>

                            <TextBlock Text="{ui:T Set_Support}" Style="{StaticResource H3}" Margin="0,26,0,8"/>
                            <Border Style="{StaticResource FlatCard}" Padding="18,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="{ui:T Set_Version}" Style="{StaticResource Caption}" Margin="0,0,0,8"/><TextBlock Grid.Column="1" Text="{Binding Info.AppVersion}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Text="{ui:T Set_Schema}" Style="{StaticResource Caption}" Margin="0,0,0,8"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Info.SchemaVersion}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="2" Text="{ui:T Set_DbPath}" Style="{StaticResource Caption}" Margin="0,0,0,8"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Info.DatabasePath}" FlowDirection="LeftToRight" HorizontalAlignment="Left" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="3" Text="{ui:T Set_DbSize}" Style="{StaticResource Caption}" Margin="0,0,0,8"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DatabaseSize}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="4" Text="{ui:T Set_FreeDisk}" Style="{StaticResource Caption}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FreeDisk}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>
                            <Border Background="{StaticResource DangerTintBrush}" CornerRadius="8" Padding="14,10" Margin="0,12,0,0" Visibility="{Binding LowDisk, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{ui:T Set_LowDisk}" Foreground="{StaticResource DangerTextBrush}" FontWeight="Medium" TextWrapping="Wrap" TextTrimming="None"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{ui:T Pay_Settings}">
                    <Grid DataContext="{Binding Payments}" Margin="0,16,0,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{ui:T Pay_ManualOnly}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10"><Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="80"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><CheckBox Content="{ui:T Pay_Enabled}" IsChecked="{Binding Enabled}"/><TextBlock Text="{Binding Kind}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="{ui:T Pay_NameEn}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NameEn,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Text="{ui:T Pay_NameAr}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding NameAr,UpdateSourceTrigger=PropertyChanged}" FlowDirection="RightToLeft"/></StackPanel>
                                <StackPanel Grid.Column="5"><TextBlock Text="{ui:T Pay_Sort}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Sort,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/></StackPanel>
                                <Button Grid.Column="7" Content="{ui:T Action_Save}" Command="{Binding DataContext.SaveCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" VerticalAlignment="Bottom"/>
                            </Grid></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                        <TextBlock Grid.Row="2" Text="{Binding Error}" Style="{StaticResource ErrorText}" TextWrapping="Wrap"/>
                    </Grid>
                </TabItem>
                <TabItem Header="{ui:T Promo_Settings}"><views:PromotionSettingsView DataContext="{Binding Promotions}"/></TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
