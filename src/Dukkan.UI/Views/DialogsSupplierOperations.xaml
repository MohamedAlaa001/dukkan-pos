<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Dukkan.UI">
    <Style x:Key="SupplierLtrHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderRight}">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>
    <DataTemplate DataType="{x:Type ui:SupplierOperationsViewModel}">
        <Border Style="{StaticResource DialogCard}" Width="{Binding Width}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="440"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ContentPresenter ContentTemplate="{StaticResource DialogHeaderTemplate}" Content="{ui:T PO_Operations}"/>
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" AutomationProperties.Name="Supplier account"/>
                    <Button Grid.Column="2" Command="{Binding NewOrderCommand}" Content="{ui:T PO_New}"/>
                    <Button Grid.Column="4" Command="{Binding NewReturnCommand}" Content="{ui:T SR_New}" Style="{StaticResource PrimaryButton}"/>
                </Grid>
                <TabControl Grid.Row="2" SelectedIndex="{Binding Tab}">
                    <TabItem Header="{ui:T PO_Orders}">
                        <DockPanel Margin="0,12,0,0">
                            <CheckBox DockPanel.Dock="Top" Content="{ui:T PO_OpenOnly}" IsChecked="{Binding OnlyOpen}" Margin="0,0,0,10"/>
                            <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Orders}" RowHeight="44" AutomationProperties.Name="Purchase orders">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{ui:T Col_Reference}" Binding="{Binding Number}" Width="120" ElementStyle="{StaticResource Ltr}" HeaderStyle="{StaticResource SupplierLtrHeader}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Supplier}" Binding="{Binding Supplier}" Width="*" MinWidth="130" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="{ui:T PO_Expected}" Binding="{Binding Date}" Width="145" ElementStyle="{StaticResource Ltr}" HeaderStyle="{StaticResource SupplierLtrHeader}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Status}" Binding="{Binding Status}" Width="150" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Total}" Binding="{Binding Total, StringFormat=N2}" Width="110" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SupplierLtrHeader}"/>
                                    <DataGridTemplateColumn Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" Content="{ui:T Action_View}" Command="{Binding DataContext.OpenOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="{ui:T SR_Returns}">
                        <DockPanel Margin="0,12,0,0">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="{ui:T SR_Credit}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Credit, Converter={StaticResource MoneyConv}}" Foreground="{StaticResource OrangeBrush}" FontWeight="Bold" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                            </StackPanel>
                            <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Returns}" RowHeight="46" AutomationProperties.Name="Supplier returns">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{ui:T Col_Reference}" Binding="{Binding Number}" Width="130" ElementStyle="{StaticResource Ltr}" HeaderStyle="{StaticResource SupplierLtrHeader}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Date}" Binding="{Binding Date}" Width="120" ElementStyle="{StaticResource Ltr}" HeaderStyle="{StaticResource SupplierLtrHeader}"/>
                                    <DataGridTextColumn Header="{ui:T Inv_Reason}" Binding="{Binding Reason}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Total}" Binding="{Binding Total, StringFormat=N2}" Width="110" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SupplierLtrHeader}"/>
                                    <DataGridTextColumn Header="{ui:T Col_Status}" Binding="{Binding Status}" Width="170" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTemplateColumn Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" Content="{ui:T Sup_Reverse}" Visibility="{Binding CanReverse, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.ReverseReturnCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="{ui:T PO_Trading}">
                        <StackPanel Margin="0,12,0,0">
                            <WrapPanel Margin="0,0,0,18">
                                <TextBox Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{ui:T Sup_From}" FlowDirection="LeftToRight" Width="140" Margin="0,0,10,0"/>
                                <TextBox Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{ui:T Sup_To}" FlowDirection="LeftToRight" Width="140" Margin="0,0,10,0"/>
                                <Button Command="{Binding ExportCommand}" Content="{ui:T Action_Export}"/>
                            </WrapPanel>
                            <UniformGrid Columns="3">
                                <ui:StatCard Caption="{ui:T PO_Purchases}" Value="{Binding Purchases, StringFormat=N2}"/>
                                <ui:StatCard Caption="{ui:T SR_Returns}" Value="{Binding ReturnsTotal, StringFormat=N2}" Margin="10,0"/>
                                <ui:StatCard Caption="{ui:T PO_Net}" Value="{Binding NetPurchases, StringFormat=N2}"/>
                            </UniformGrid>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="{ui:T Sup_TabStatement}">
                        <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Statement}" Margin="0,12,0,0" RowHeight="44">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{ui:T Col_Date}" Binding="{Binding Date}" Width="120" ElementStyle="{StaticResource Ltr}" HeaderStyle="{StaticResource SupplierLtrHeader}"/>
                                <DataGridTextColumn Header="{ui:T Col_Reference}" Binding="{Binding Document}" Width="130" ElementStyle="{StaticResource Ltr}" HeaderStyle="{StaticResource SupplierLtrHeader}"/>
                                <DataGridTextColumn Header="{ui:T Col_Type}" Binding="{Binding Type}" Width="*" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="{ui:T Col_Amount}" Binding="{Binding Amount, StringFormat=N2}" Width="120" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SupplierLtrHeader}"/>
                                <DataGridTextColumn Header="{ui:T Cust_Running}" Binding="{Binding Running, StringFormat=N2}" Width="120" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SupplierLtrHeader}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
                <Button Grid.Row="3" Command="{Binding CloseCommand}" Content="{ui:T Action_Close}" HorizontalAlignment="Right" MinWidth="120" Margin="0,16,0,0"/>
            </Grid>
        </Border>
    </DataTemplate>
    <DataTemplate DataType="{x:Type ui:PurchaseOrderDetailsViewModel}">
        <Border Style="{StaticResource DialogCard}" Width="{Binding Width}">
            <StackPanel>
                <ContentPresenter ContentTemplate="{StaticResource DialogHeaderTemplate}" Content="{ui:T PO_Title}"/>
                <TextBlock Text="{Binding Order.Number}" FontWeight="Bold" FlowDirection="LeftToRight" FontSize="20"/>
                <TextBlock Text="{Binding Order.Supplier}" FontSize="16" Margin="0,4,0,8"/>
                <TextBlock Text="{Binding Order.Status}" FontWeight="SemiBold" Foreground="{StaticResource OrangeBrush}"/>
                <TextBlock Text="{ui:T PO_NoPosting}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,16"/>
                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Lines}" Height="260" RowHeight="44">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{ui:T Col_Product}" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="{ui:T Col_Qty}" Binding="{Binding Quantity, StringFormat=0.###}" Width="90" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SupplierLtrHeader}"/>
                        <DataGridTextColumn Header="{ui:T PO_Received}" Binding="{Binding Received, StringFormat=0.###}" Width="120" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SupplierLtrHeader}"/>
                        <DataGridTextColumn Header="{ui:T Col_Remaining}" Binding="{Binding Remaining, StringFormat=0.###}" Width="100" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SupplierLtrHeader}"/>
                        <DataGridTextColumn Header="{ui:T Field_CostPrice}" Binding="{Binding UnitCost, StringFormat=N4}" Width="120" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource SupplierLtrHeader}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Margin="0,16,0,0">
                    <Button Command="{Binding PrintCommand}" Content="{ui:T Action_Print}" Margin="0,0,8,8"/>
                    <Button Command="{Binding PdfCommand}" Content="{ui:T Action_SavePdf}" Margin="0,0,8,8"/>
                    <Button Command="{Binding CancelOrderCommand}" Content="{ui:T PO_Cancel}" Margin="0,0,8,8"/>
                    <Button Command="{Binding SendCommand}" Content="{ui:T PO_Send}" Margin="0,0,8,8"/>
                    <Button Command="{Binding ReceiveCommand}" Content="{ui:T PO_Receive}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </DataTemplate>
    <DataTemplate DataType="{x:Type ui:SupplierReturnViewModel}">
        <Border Style="{StaticResource DialogCard}" Width="{Binding Width}">
            <Grid MaxHeight="610">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <ContentPresenter ContentTemplate="{StaticResource DialogHeaderTemplate}" Content="{ui:T SR_New}"/>
                    <TextBlock Text="{Binding SupplierName}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{ui:T SR_Explanation}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <TextBlock Text="{ui:T SR_Invoice}" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Invoices}" SelectedItem="{Binding Invoice}" DisplayMemberPath="Number"/>
                            <Button Grid.Column="2" Command="{Binding ClearInvoiceCommand}" Content="{ui:T SR_NoInvoice}"/>
                        </Grid>
                        <Grid Margin="0,14,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{ui:T Col_Date}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Date}" FlowDirection="LeftToRight"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="{ui:T Inv_Reason}" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Reasons}" SelectedItem="{Binding Reason}"/></StackPanel>
                        </Grid>
                        <StackPanel Visibility="{Binding IsUnlinked, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{ui:T SR_UnlinkedNote}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{ui:T Sup_AddItem}"/>
                            <ItemsControl ItemsSource="{Binding Results}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Button Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="{Binding FullName}" Margin="0,4,0,0"/>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                        <Grid Margin="0,14,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{ui:T Col_Product}" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="1" Text="{ui:T SR_Max}" Style="{StaticResource Caption}" FlowDirection="LeftToRight" TextAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{ui:T Col_Qty}" Style="{StaticResource Caption}" FlowDirection="LeftToRight" TextAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{ui:T Field_CostPrice}" Style="{StaticResource Caption}" FlowDirection="LeftToRight" TextAlignment="Center"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Lines}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Maximum, StringFormat=0.###}" FlowDirection="LeftToRight" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="2" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="6,0"/>
                                <TextBox Grid.Column="3" Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding CostReadOnly}" FlowDirection="LeftToRight" Margin="6,0"/>
                                <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="0,8,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Locations}" SelectedValuePath="Id" SelectedValue="{Binding LocationId}"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Lots}" SelectedItem="{Binding Lot}"/>
                                </Grid>
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="{ui:T Col_Notes}" Style="{StaticResource FieldLabel}" Margin="0,10,0,6"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2">
                    <Grid Margin="0,12,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{ui:T Col_Total}"/><TextBlock Text="{ui:T SR_After}" Margin="0,6,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" FlowDirection="LeftToRight" HorizontalAlignment="Right"><TextBlock Text="{Binding Total, Converter={StaticResource MoneyConv}}" FontWeight="Bold"/><TextBlock Text="{Binding BalanceAfter, Converter={StaticResource MoneyConv}}" Margin="0,6,0,0"/></StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" TextWrapping="Wrap"/>
                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                        <Button Command="{Binding CloseCommand}" Content="{ui:T Action_Cancel}"/>
                        <Button Grid.Column="2" Command="{Binding SaveCommand}" Content="{ui:T SR_Post}" Style="{StaticResource PrimaryButton}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
    <DataTemplate DataType="{x:Type ui:SupplierReturnReverseViewModel}">
        <Border Style="{StaticResource DialogCard}" Width="{Binding Width}"><StackPanel>
            <ContentPresenter ContentTemplate="{StaticResource DialogHeaderTemplate}" Content="{ui:T SR_Reverse}"/>
            <TextBlock Text="{Binding Number}" FlowDirection="LeftToRight" FontWeight="Bold" Margin="0,0,0,12"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="350"><StackPanel>
                <TextBlock Text="{ui:T Stock_RestockLot}" TextWrapping="Wrap" Visibility="{Binding NeedsLots,Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,12,0,0">
                    <TextBlock Text="{Binding Product}" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Lots}" SelectedItem="{Binding Lot}" Margin="0,6,0,6"/>
                    <UniformGrid Columns="2"><TextBox Text="{Binding Batch,UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{ui:T Stock_Batch}" FlowDirection="LeftToRight" Margin="0,0,6,0"/><TextBox Text="{Binding Expiry,UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="yyyy-MM-dd" FlowDirection="LeftToRight"/></UniformGrid>
                </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></ScrollViewer>
            <TextBox Text="{Binding Reason,UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{ui:T Stock_ApprovalReason}" Margin="0,16,0,0"/>
            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" TextWrapping="Wrap"/>
            <UniformGrid Columns="2" Margin="0,16,0,0"><Button Command="{Binding CloseCommand}" Content="{ui:T Action_Cancel}" Margin="0,0,8,0"/><Button Command="{Binding SaveCommand}" Content="{ui:T SR_Reverse}" Style="{StaticResource PrimaryButton}"/></UniformGrid>
        </StackPanel></Border>
    </DataTemplate>
</ResourceDictionary>
