<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Dukkan.UI">
 <DataTemplate DataType="{x:Type ui:CountOpenViewModel}">
  <Border Style="{StaticResource DialogCard}" Width="{Binding Width}"><StackPanel>
   <ContentPresenter ContentTemplate="{StaticResource DialogHeaderTemplate}" Content="{ui:T Stock_OpenCount}"/>
   <TextBlock Text="{ui:T Stock_ScopeHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
   <UniformGrid Columns="2">
    <StackPanel Margin="0,0,12,0"><TextBlock Text="{ui:T Stock_Location}" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding Location}"/></StackPanel>
    <StackPanel><TextBlock Text="{ui:T Stock_Counts}" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}"/></StackPanel>
   </UniformGrid>
   <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Visibility="{Binding IsCategory,Converter={StaticResource BoolToVis}}" Margin="0,14,0,0"/>
   <StackPanel Visibility="{Binding IsSelection,Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
    <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{ui:T Inv_FindPh}"/>
    <ListBox ItemsSource="{Binding VisibleProducts}" Height="260" Margin="0,8,0,0" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Product.Name}" IsChecked="{Binding Selected}" Padding="2,6"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </StackPanel>
   <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
   <UniformGrid Columns="2" Margin="0,16,0,0"><Button Command="{Binding CloseCommand}" Content="{ui:T Action_Cancel}" Margin="0,0,8,0"/><Button Command="{Binding SaveCommand}" Content="{ui:T Stock_OpenCount}" Style="{StaticResource PrimaryButton}"/></UniformGrid>
  </StackPanel></Border>
 </DataTemplate>
</ResourceDictionary>
