<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Dukkan.UI">

    <Style x:Key="DialogCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Effect" Value="{StaticResource DialogShadow}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.97" To="1" Duration="0:0:0.14"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.97" To="1" Duration="0:0:0.14"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- Reusable dialog header: title + close icon button. -->
    <DataTemplate x:Key="DialogHeaderTemplate">
        <Grid Margin="0,0,0,18">
            <TextBlock Text="{Binding}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,-6,-8,-6" Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=Border}}"
                    AutomationProperties.Name="Close">
                <ui:GlyphIcon Glyph="{x:Static ui:Icons.Close}" FontSize="14"/>
            </Button>
        </Grid>
    </DataTemplate>

    <!-- ===== Confirm ===== -->
    <DataTemplate DataType="{x:Type ui:ConfirmViewModel}">
        <Border Style="{StaticResource DialogCard}" Width="{Binding Width}">
            <StackPanel>
                <ContentPresenter ContentTemplate="{StaticResource DialogHeaderTemplate}" Content="{Binding Title}"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextTrimming="None" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,24"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Content="{ui:T Action_Cancel}" Command="{Binding CloseCommand}" IsCancel="True" MinHeight="42"/>
                    <Button Grid.Column="2" Style="{StaticResource DangerButton}" Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" MinHeight="42" Visibility="{Binding IsDanger, Converter={StaticResource BoolToVis}}"/>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmCommand}" Content="{Binding ConfirmText}" MinHeight="42" Visibility="{Binding IsDanger, Converter={StaticResource InvBoolToVis}}"/>
                </Grid>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ===== Discount ===== -->
    <DataTemplate DataType="{x:Type ui:DiscountViewModel}">
        <Border Style="{StaticResource DialogCard}" Width="{Binding Width}">
            <StackPanel>
                <ContentPresenter ContentTemplate="{StaticResource DialogHeaderTemplate}" Content="{ui:T Pos_Discount}"/>
                <TextBlock Text="{ui:T Disc_Presets}" Style="{StaticResource FieldLabel}"/>
                <ItemsControl ItemsSource="{Binding Presets}" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,8,0" Command="{Binding DataContext.PresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="{Binding StringFormat={}{0}%}" FontWeight="SemiBold"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{ui:T Disc_Custom}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Custom, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="0" FlowDirection="LeftToRight" AutomationProperties.Name="Custom discount"/>
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[Custom]}"/>
                <Border Background="{StaticResource SurfaceSubtleBrush}" CornerRadius="8" Padding="14,10" Margin="0,16,0,0">
                    <Grid>
                        <TextBlock Text="{ui:T Disc_Amount}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Amount, Converter={StaticResource MoneyConv}}" FontWeight="Bold" HorizontalAlignment="Right" FlowDirection="LeftToRight"/>
                    </Grid>
                </Border>
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding RemoveCommand}" Content="{ui:T Disc_Remove}"/>
                    <Button Grid.Column="2" Content="{ui:T Action_Cancel}" Command="{Binding CloseCommand}" MinHeight="42" Margin="0,0,10,0"/>
                    <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="{ui:T Action_Apply}" Command="{Binding ApplyCommand}" MinHeight="42" MinWidth="110"/>
                </Grid>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ===== Open shift ===== -->
    <DataTemplate DataType="{x:Type ui:OpenShiftViewModel}">
        <Border Style="{StaticResource DialogCard}" Width="{Binding Width}">
            <StackPanel>
                <ContentPresenter ContentTemplate="{StaticResource DialogHeaderTemplate}" Content="{ui:T Shift_OpenTitle}"/>
                <TextBlock Text="{ui:T Shift_OpenNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,-6,0,14"/>
                <TextBlock Text="{ui:T Shift_Float}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Float, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AmountTextBox}" AutomationProperties.Name="Opening float"/>
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[Float]}"/>
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Content="{ui:T Action_Cancel}" Command="{Binding CloseCommand}" MinHeight="44"/>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding OpenCommand}" Content="{ui:T Shift_OpenTitle}" MinHeight="44" IsDefault="True"/>
                </Grid>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ===== Close shift (blind count, then review) ===== -->
    <DataTemplate DataType="{x:Type ui:CloseShiftViewModel}">
        <Border Style="{StaticResource DialogCard}" Width="{Binding Width}">
            <StackPanel>
                <ContentPresenter ContentTemplate="{StaticResource DialogHeaderTemplate}" Content="{ui:T Shift_CloseTitle}"/>
                <StackPanel Visibility="{Binding IsCountStage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{ui:T Shift_CountNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,-6,0,14"/>
                    <TextBlock Text="{ui:T Shift_Counted}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Counted, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AmountTextBox}" AutomationProperties.Name="Counted cash"/>
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[Counted]}"/>
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Content="{ui:T Action_Cancel}" Command="{Binding CloseCommand}" MinHeight="44"/>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding CountCommand}" Content="{ui:T Action_Continue}" MinHeight="44" IsDefault="True"/>
                    </Grid>
                </StackPanel>
                <StackPanel Visibility="{Binding IsReviewStage, Converter={StaticResource BoolToVis}}">
                    <Border Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                        <UniformGrid Columns="3">
                            <StackPanel><TextBlock Text="{ui:T Shift_Expected}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Expected, Converter={StaticResource MoneyConv}}" FontWeight="Bold" FontSize="16" FlowDirection="LeftToRight" HorizontalAlignment="Left"/></StackPanel>
                            <StackPanel><TextBlock Text="{ui:T Shift_Counted}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding CountedValue, Converter={StaticResource MoneyConv}}" FontWeight="Bold" FontSize="16" FlowDirection="LeftToRight" HorizontalAlignment="Left"/></StackPanel>
                            <StackPanel><TextBlock Text="{ui:T Shift_Variance}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Variance, StringFormat=+0.00;-0.00;0.00}" FontWeight="Bold" FontSize="16" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                       Foreground="{StaticResource TextPrimaryBrush}"/></StackPanel>
                        </UniformGrid>
                    </Border>
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="{ui:T Pay_MethodBreakdown}" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding PaymentTotals}"><ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Net,Converter={StaticResource MoneyConv}}" FlowDirection="LeftToRight" FontWeight="SemiBold"/></Grid>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                        <TextBlock Text="{ui:T Pay_ShiftMethodHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding HasVariance, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{ui:T Shift_Reason}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Variance reason"/>
                        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[Reason]}"/>
                    </StackPanel>
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Content="{ui:T Action_Back}" Command="{Binding BackCommand}" MinHeight="44"/>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding CloseShiftCommand}" Content="{ui:T Shift_CloseTitle}" MinHeight="44" IsDefault="True"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ===== Recovery: reset the owner password with a code ===== -->
    <DataTemplate DataType="{x:Type ui:RecoveryResetViewModel}">
        <Border Style="{StaticResource DialogCard}" Width="{Binding Width}">
            <StackPanel>
                <ContentPresenter ContentTemplate="{StaticResource DialogHeaderTemplate}" Content="{ui:T Login_Forgot}"/>
                <StackPanel Visibility="{Binding IsForm, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{ui:T Recovery_Note}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,-6,0,14"/>
                    <TextBlock Text="{ui:T Login_Username}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" AutomationProperties.Name="Owner username"/>
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[Username]}"/>
                    <TextBlock Text="{ui:T Recovery_Code}" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="XXXX-XXXX-XXXX" FlowDirection="LeftToRight" AutomationProperties.Name="Recovery code"/>
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[Code]}"/>
                    <TextBlock Text="{ui:T Recovery_NewPassword}" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                    <PasswordBox ui:Ui.Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Icon="{x:Static ui:Icons.Lock}" AutomationProperties.Name="New password"/>
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[NewPassword]}"/>
                    <TextBlock Text="{ui:T Setup_Confirm}" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                    <PasswordBox ui:Ui.Password="{Binding Confirm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Icon="{x:Static ui:Icons.Lock}" AutomationProperties.Name="Confirm new password"/>
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[Confirm]}"/>
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Content="{ui:T Action_Cancel}" Command="{Binding CloseCommand}" MinHeight="44"/>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding ResetCommand}" Content="{ui:T Recovery_Reset}" MinHeight="44" IsDefault="True"/>
                    </Grid>
                </StackPanel>
                <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                    <Border Background="{StaticResource SuccessTintBrush}" CornerRadius="10" Padding="16,12">
                        <TextBlock Text="{ui:T Recovery_Done}" TextWrapping="Wrap" TextTrimming="None" Foreground="{StaticResource SuccessTextBrush}" FontWeight="Medium"/>
                    </Border>
                    <TextBlock Text="{ui:T Recovery_Replacement}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                    <TextBlock Text="{Binding ReplacementCode}" FontFamily="Consolas" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CloseCommand}" Content="{ui:T Action_Close}" MinHeight="44" Margin="0,22,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ===== Owner approval ===== -->
    <DataTemplate DataType="{x:Type ui:ApprovalViewModel}">
        <Border Style="{StaticResource DialogCard}" Width="{Binding Width}">
            <StackPanel>
                <ContentPresenter ContentTemplate="{StaticResource DialogHeaderTemplate}" Content="{ui:T Approval_Title}"/>
                <Border Background="{StaticResource OrangeTintBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                    <TextBlock Text="{Binding ActionText}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None"/>
                </Border>
                <TextBlock Text="{ui:T Approval_Note}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,12"/>
                <TextBlock Text="{ui:T Login_Username}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Icon="{x:Static ui:Icons.Person}" FlowDirection="LeftToRight" AutomationProperties.Name="Owner username"/>
                <TextBlock Text="{ui:T Login_Password}" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                <PasswordBox ui:Ui.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Icon="{x:Static ui:Icons.Lock}" AutomationProperties.Name="Owner password"/>
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errs[Password]}"/>
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Content="{ui:T Action_Cancel}" Command="{Binding CloseCommand}" MinHeight="44"/>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding ApproveCommand}" Content="{ui:T Approval_Approve}" MinHeight="44" IsDefault="True"/>
                </Grid>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
