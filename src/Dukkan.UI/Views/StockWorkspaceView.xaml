<UserControl x:Class="Dukkan.UI.Views.StockWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Dukkan.UI">
 <UserControl.Resources>
  <Style x:Key="StockHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderRight}"><Setter Property="FlowDirection" Value="LeftToRight"/></Style>
 </UserControl.Resources>
 <Grid Margin="24,12,24,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Command="{Binding ReloadCommand}" Content="{ui:T Action_Refresh}" Margin="0,0,8,0"/>
    <Button Command="{Binding ReceiveCommand}" Content="{ui:T Inv_NewMovement}" Style="{StaticResource PrimaryButton}" Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}"/>
   </StackPanel>
   <TextBlock Text="{ui:T Inv_Title}" Style="{StaticResource H1}"/>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14" Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{ui:T Stock_Location}" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding Location}"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="{ui:T Stock_ProductScope}" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding Product}" IsTextSearchEnabled="True" TextSearch.TextPath="Name"/></StackPanel>
    <Button Grid.Column="3" Command="{Binding ClearProductCommand}" Content="{ui:T Stock_AllProducts}" Margin="12,22,0,0"/>
   </Grid>
  </Border>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,0,16,12">
   <TabControl SelectedIndex="{Binding Tab}">
    <TabItem Header="{ui:T Stock_Counts}">
     <Grid Margin="0,12,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <WrapPanel>
       <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding Session}" Width="230" Margin="0,0,12,0"/>
       <TextBlock Text="{Binding SessionStatus}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
       <Button Command="{Binding CreateCountCommand}" Content="{ui:T Stock_OpenCount}" Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}"/>
       <Button Command="{Binding PrintCommand}" Content="{ui:T Stock_PrintSheet}" Margin="10,0,0,0"/>
       <Button Command="{Binding ExportCommand}" Content="{ui:T Action_Export}" Margin="10,0,0,0"/>
      </WrapPanel>
      <TextBlock Grid.Row="1" Text="{ui:T Stock_CountPolicy}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,10"/>
      <DataGrid Grid.Row="2" Style="{StaticResource DataTable}" ItemsSource="{Binding CountLines}" RowHeight="48">
       <DataGrid.Columns>
        <DataGridTextColumn Header="{ui:T Col_Product}" Binding="{Binding Row.Product}" Width="*" MinWidth="170" ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="{ui:T Stock_Batch}" Binding="{Binding Row.Batch}" Width="120" ElementStyle="{StaticResource Ltr}" HeaderStyle="{StaticResource StockHeader}"/>
        <DataGridTextColumn Header="{ui:T Stock_Expected}" Binding="{Binding Row.Expected, StringFormat=0.###}" Width="110" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource StockHeader}"/>
        <DataGridTemplateColumn Header="{ui:T Stock_Counted}" Width="120" HeaderStyle="{StaticResource StockHeader}"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="6" MinHeight="32" IsEnabled="{Binding DataContext.CountOpen,RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="{ui:T Stock_Variance}" Binding="{Binding Row.Variance, StringFormat=0.###}" Width="110" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource StockHeader}"/>
        <DataGridTemplateColumn Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{ui:T Stock_Recount}" Command="{Binding DataContext.RecountCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" MinHeight="32" Margin="4" IsEnabled="{Binding DataContext.CountOpen,RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
      <StackPanel Grid.Row="3" Margin="0,12,0,0">
       <DockPanel Visibility="{Binding IsOwner,Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
        <TextBlock Text="{ui:T Stock_VarianceValue}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <TextBlock Text="{Binding VarianceValue,StringFormat=N2}" FlowDirection="LeftToRight" FontWeight="Bold" VerticalAlignment="Center"/>
       </DockPanel>
       <DockPanel IsEnabled="{Binding CountOpen}">
        <Button DockPanel.Dock="Right" Command="{Binding SaveCountCommand}" Content="{ui:T Stock_SaveCounts}" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"/>
        <Button DockPanel.Dock="Right" Command="{Binding ApproveCountCommand}" Content="{ui:T Stock_ApproveCount}" Visibility="{Binding IsOwner,Converter={StaticResource BoolToVis}}" Margin="12,0,0,0"/>
        <Button DockPanel.Dock="Right" Command="{Binding CancelCountCommand}" Content="{ui:T Stock_CancelCount}" Visibility="{Binding IsOwner,Converter={StaticResource BoolToVis}}" Margin="12,0,0,0"/>
        <TextBox Text="{Binding Reason,UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{ui:T Stock_ApprovalReason}" Visibility="{Binding IsOwner,Converter={StaticResource BoolToVis}}"/>
       </DockPanel>
      </StackPanel>
     </Grid>
    </TabItem>
    <TabItem Header="{ui:T Inv_TabLevels}" Visibility="{Binding IsOwner,Converter={StaticResource BoolToVis}}">
     <DockPanel Margin="0,12,0,0">
      <Button DockPanel.Dock="Bottom" Command="{Binding HistoryCommand}" Content="{ui:T Inv_TabMovements}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
      <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Levels}" RowHeight="46">
       <DataGrid.Columns>
        <DataGridTextColumn Header="{ui:T Col_Product}" Binding="{Binding Product}" Width="*" ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="{ui:T Stock_Location}" Binding="{Binding Location}" Width="150" ElementStyle="{StaticResource CellText}"/>
        <DataGridTextColumn Header="{ui:T Col_Qty}" Binding="{Binding Quantity,StringFormat=0.###}" Width="100" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource StockHeader}"/>
        <DataGridTextColumn Header="{ui:T Stock_Value}" Binding="{Binding ValueAtCost,StringFormat=N2}" Width="140" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource StockHeader}"/>
        <DataGridTextColumn Header="{ui:T Stock_Earliest}" Binding="{Binding EarliestExpiry}" Width="150" ElementStyle="{StaticResource Ltr}" HeaderStyle="{StaticResource StockHeader}"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </TabItem>
    <TabItem Header="{ui:T Stock_Transfers}" Visibility="{Binding IsOwner,Converter={StaticResource BoolToVis}}">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="700" HorizontalAlignment="Left" Margin="0,16,0,0">
      <TextBlock Text="{ui:T Stock_TransferHint}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,0,0,14"/>
      <TextBlock Text="{ui:T Stock_Destination}" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding Destination}"/>
      <TextBlock Text="{ui:T Stock_LotOptional}" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/><ComboBox ItemsSource="{Binding Lots}" SelectedItem="{Binding Lot}"/>
      <TextBlock Text="{ui:T Col_Qty}" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/><TextBox Text="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
      <Button Command="{Binding TransferCommand}" Content="{ui:T Stock_PostTransfer}" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"/>
      <TextBlock Text="{ui:T Stock_AdjustHint}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,22,0,12"/>
      <TextBox Text="{Binding Cost,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ui:Ui.Placeholder="{ui:T Field_CostPrice}"/>
      <TextBox Text="{Binding Reason,UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{ui:T Stock_ApprovalReason}" Margin="0,10,0,0"/>
      <Button Command="{Binding AdjustCommand}" Content="{ui:T Stock_Adjust}" Margin="0,12,0,0"/>
     </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem Header="{ui:T Stock_ProductRules}" Visibility="{Binding IsOwner,Converter={StaticResource BoolToVis}}">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,0,0" MaxWidth="700" HorizontalAlignment="Left">
      <TextBlock Text="{ui:T Stock_RulesHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
      <CheckBox Content="{ui:T Stock_TrackExpiry}" IsChecked="{Binding TrackExpiry}"/>
      <UniformGrid Columns="2" Margin="0,14,0,0">
       <StackPanel Margin="0,0,12,0"><TextBlock Text="{ui:T Stock_Batch}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Batch,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/></StackPanel>
       <StackPanel><TextBlock Text="{ui:T Stock_ExpiryDate}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Expiry,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ui:Ui.Placeholder="yyyy-MM-dd"/></StackPanel>
      </UniformGrid>
      <TextBox Text="{Binding Quantity,UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="{ui:T Col_Qty}" FlowDirection="LeftToRight" Margin="0,12,0,0"/>
      <Button Command="{Binding ClassifyCommand}" Content="{ui:T Stock_Classify}" Margin="0,10,0,0"/>
      <Button Command="{Binding DefineLotCommand}" Content="{ui:T Stock_DefineLot}" Margin="0,8,0,0"/>
      <UniformGrid Columns="2" Margin="0,14,0,0">
       <StackPanel Margin="0,0,12,0"><TextBlock Text="{ui:T Stock_Point}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Point,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/></StackPanel>
       <StackPanel><TextBlock Text="{ui:T Stock_Target}" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Target,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/></StackPanel>
      </UniformGrid>
      <TextBlock Text="{ui:T Stock_Preferred}" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/><ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}"/>
      <Button Command="{Binding ConfigureCommand}" Content="{ui:T Action_Save}" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"/>
     </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem Header="{ui:T Stock_Expiry}" Visibility="{Binding IsOwner,Converter={StaticResource BoolToVis}}">
     <DockPanel Margin="0,12,0,0">
      <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="{ui:T Stock_WarningDays}" VerticalAlignment="Center"/><TextBox Text="{Binding Days,UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Width="90" Margin="12,0"/><Button Command="{Binding WarningCommand}" Content="{ui:T Action_Save}"/></WrapPanel>
      <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Expiring}" RowHeight="46"><DataGrid.Columns>
       <DataGridTextColumn Header="{ui:T Col_Product}" Binding="{Binding Product}" Width="*" ElementStyle="{StaticResource CellText}"/>
       <DataGridTextColumn Header="{ui:T Stock_Location}" Binding="{Binding Location}" Width="140" ElementStyle="{StaticResource CellText}"/>
       <DataGridTextColumn Header="{ui:T Stock_Batch}" Binding="{Binding Batch}" Width="120" ElementStyle="{StaticResource Ltr}" HeaderStyle="{StaticResource StockHeader}"/>
       <DataGridTextColumn Header="{ui:T Stock_ExpiryDate}" Binding="{Binding Expiry}" Width="140" ElementStyle="{StaticResource Ltr}" HeaderStyle="{StaticResource StockHeader}"/>
       <DataGridTextColumn Header="{ui:T Col_Qty}" Binding="{Binding Quantity,StringFormat=0.###}" Width="90" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource StockHeader}"/>
      </DataGrid.Columns></DataGrid>
     </DockPanel>
    </TabItem>
    <TabItem Header="{ui:T Stock_Reorder}" Visibility="{Binding IsOwner,Converter={StaticResource BoolToVis}}">
     <DockPanel Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="{ui:T Stock_ReorderHint}" TextWrapping="Wrap" Style="{StaticResource Caption}"/><WrapPanel Margin="0,12,0,0"><ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" Width="240"/><Button Command="{Binding ReorderCommand}" Content="{ui:T PO_New}" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"/></WrapPanel></StackPanel>
      <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Suggestions}" RowHeight="46"><DataGrid.Columns>
       <DataGridTextColumn Header="{ui:T Col_Supplier}" Binding="{Binding Supplier}" Width="170" ElementStyle="{StaticResource CellText}"/>
       <DataGridTextColumn Header="{ui:T Col_Product}" Binding="{Binding Product}" Width="*" ElementStyle="{StaticResource CellText}"/>
       <DataGridTextColumn Header="{ui:T Col_Stock}" Binding="{Binding OnHand,StringFormat=0.###}" Width="100" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource StockHeader}"/>
       <DataGridTextColumn Header="{ui:T Stock_Sales30}" Binding="{Binding Sales30Days,StringFormat=0.###}" Width="130" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource StockHeader}"/>
       <DataGridTextColumn Header="{ui:T Stock_Suggested}" Binding="{Binding Quantity,StringFormat=0.###}" Width="130" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource StockHeader}"/>
      </DataGrid.Columns></DataGrid>
     </DockPanel>
    </TabItem>
    <TabItem Header="{ui:T Stock_Locations}" Visibility="{Binding IsOwner,Converter={StaticResource BoolToVis}}">
     <StackPanel Margin="0,16,0,0" MaxWidth="600" HorizontalAlignment="Left">
      <TextBlock Text="{ui:T Stock_SalesLocation}" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding SalesLocationName}" FontSize="22" Margin="0,0,0,16"/>
      <Button Command="{Binding SalesLocationCommand}" Content="{ui:T Stock_SetSalesLocation}"/>
      <TextBlock Text="{ui:T Stock_NewLocation}" Style="{StaticResource FieldLabel}" Margin="0,22,0,6"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/>
      <Button Command="{Binding CreateLocationCommand}" Content="{ui:T Action_Add}" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"/>
     </StackPanel>
    </TabItem>
   </TabControl>
  </Border>
  <TextBlock Grid.Row="3" Text="{Binding Error}" Style="{StaticResource ErrorText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
 </Grid>
</UserControl>
