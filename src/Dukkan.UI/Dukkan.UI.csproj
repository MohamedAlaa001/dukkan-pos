    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Dukkan.UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Dukkan</AssemblyName>
    <ApplicationIcon>Assets\dukkan.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
