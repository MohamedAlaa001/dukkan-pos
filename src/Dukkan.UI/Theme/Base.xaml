<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Dukkan.UI">

    <ui:MoneyConverter x:Key="MoneyConv"/>
    <ui:NumberConverter x:Key="NumberConv"/>
    <ui:InverseBoolConverter x:Key="InvBool"/>
    <ui:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    <ui:CountToVisibilityConverter x:Key="CountToVis"/>
    <ui:EqualsConverter x:Key="EqualsConv"/>
    <ui:HexBrushConverter x:Key="HexBrush"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- ===== Typography ===== -->
    <!-- Font, size and colour are inherited from the window root (TextElement.*) so buttons and badges can recolour their text. -->
    <Style TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="H3" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <!-- Icon glyph text (one icon family everywhere). -->
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="None"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>
    <!-- Identifiers/amounts keep left-to-right digit order in Arabic mode. -->
    <Style x:Key="Ltr" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>

    <!-- ===== Surfaces ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>
    <Style x:Key="FlatCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
    </Style>

    <!-- ===== Scrollbars (thin, restrained) ===== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="T" Margin="2,0" CornerRadius="3" Background="{StaticResource BorderBrush}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="{StaticResource PlaceholderBrush}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/>
                            <Setter Property="Height" Value="10"/><Setter Property="MinHeight" Value="10"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Status badge ===== -->
    <Style TargetType="ui:Badge">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Badge">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,3" MinWidth="52">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Kind" Value="Success"><Setter Property="Background" Value="{StaticResource SuccessTintBrush}"/><Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}"/></Trigger>
            <Trigger Property="Kind" Value="Warning"><Setter Property="Background" Value="{StaticResource WarningTintBrush}"/><Setter Property="Foreground" Value="{StaticResource WarningTextBrush}"/></Trigger>
            <Trigger Property="Kind" Value="Danger"><Setter Property="Background" Value="{StaticResource DangerTintBrush}"/><Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/></Trigger>
            <Trigger Property="Kind" Value="Info"><Setter Property="Background" Value="{StaticResource InfoTintBrush}"/><Setter Property="Foreground" Value="{StaticResource NavyLightBrush}"/></Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Garment placeholders (simple vector silhouettes; no photos) ===== -->
    <Geometry x:Key="G_TShirt">M30,12 L42,8 Q50,17 58,8 L70,12 L92,28 L82,45 L72,39 L72,92 L28,92 L28,39 L18,45 L8,28 Z</Geometry>
    <Geometry x:Key="G_LongSleeve">M32,10 L43,6 Q50,16 57,6 L68,10 L91,32 L86,88 L73,88 L72,48 L72,92 L28,92 L28,48 L27,88 L14,88 L9,32 Z</Geometry>
    <Geometry x:Key="G_Jeans">M27,8 L73,8 L77,92 L55,92 L50,36 L45,92 L23,92 Z</Geometry>
    <Geometry x:Key="G_Shorts">M26,18 L74,18 L81,72 L55,72 L50,44 L45,72 L19,72 Z</Geometry>
    <Geometry x:Key="G_Cap">M16,64 Q16,26 50,26 Q84,26 84,64 L97,68 Q56,76 16,64 Z</Geometry>
    <Geometry x:Key="D_Collar">M42,8 L50,24 L58,8</Geometry>
    <Geometry x:Key="D_Hood">M36,9 Q50,40 64,9</Geometry>
    <Geometry x:Key="D_Zip">M50,14 L50,92</Geometry>
    <Geometry x:Key="D_Waist">M27,20 L73,20 M50,20 L50,36</Geometry>
    <Geometry x:Key="D_Rib">M28,80 L72,80</Geometry>
    <Geometry x:Key="D_CapBrim">M16,64 Q56,70 97,68</Geometry>

    <Style TargetType="ui:GarmentThumb">
        <Setter Property="Foreground" Value="#1F2937"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:GarmentThumb">
                    <Grid>
                    <Border x:Name="Photo" Visibility="Collapsed" CornerRadius="6" ClipToBounds="True">
                        <Image Source="{Binding Image, RelativeSource={RelativeSource TemplatedParent}}" Stretch="Uniform"/>
                    </Border>
                    <Viewbox x:Name="Art" Stretch="Uniform">
                        <Canvas Width="100" Height="100">
                            <Path x:Name="Shape" Data="{StaticResource G_TShirt}" Fill="{TemplateBinding Foreground}" StrokeLineJoin="Round"
                                  Stroke="#26000000" StrokeThickness="1"/>
                            <Path x:Name="Detail" Stroke="#40000000" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasImage" Value="True"><Setter TargetName="Photo" Property="Visibility" Value="Visible"/><Setter TargetName="Art" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger Property="Kind" Value="Polo"><Setter TargetName="Detail" Property="Data" Value="{StaticResource D_Collar}"/></Trigger>
                        <Trigger Property="Kind" Value="Shirt"><Setter TargetName="Detail" Property="Data" Value="{StaticResource D_Collar}"/></Trigger>
                        <Trigger Property="Kind" Value="Jeans"><Setter TargetName="Shape" Property="Data" Value="{StaticResource G_Jeans}"/><Setter TargetName="Detail" Property="Data" Value="{StaticResource D_Waist}"/></Trigger>
                        <Trigger Property="Kind" Value="Chinos"><Setter TargetName="Shape" Property="Data" Value="{StaticResource G_Jeans}"/><Setter TargetName="Detail" Property="Data" Value="{StaticResource D_Waist}"/></Trigger>
                        <Trigger Property="Kind" Value="Jacket"><Setter TargetName="Shape" Property="Data" Value="{StaticResource G_LongSleeve}"/><Setter TargetName="Detail" Property="Data" Value="{StaticResource D_Zip}"/></Trigger>
                        <Trigger Property="Kind" Value="Hoodie"><Setter TargetName="Shape" Property="Data" Value="{StaticResource G_LongSleeve}"/><Setter TargetName="Detail" Property="Data" Value="{StaticResource D_Hood}"/></Trigger>
                        <Trigger Property="Kind" Value="Sweater"><Setter TargetName="Shape" Property="Data" Value="{StaticResource G_LongSleeve}"/><Setter TargetName="Detail" Property="Data" Value="{StaticResource D_Rib}"/></Trigger>
                        <Trigger Property="Kind" Value="Shorts"><Setter TargetName="Shape" Property="Data" Value="{StaticResource G_Shorts}"/><Setter TargetName="Detail" Property="Data" Value="{StaticResource D_Waist}"/></Trigger>
                        <Trigger Property="Kind" Value="Cap"><Setter TargetName="Shape" Property="Data" Value="{StaticResource G_Cap}"/><Setter TargetName="Detail" Property="Data" Value="{StaticResource D_CapBrim}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded tile that hosts a garment placeholder. -->
    <Style x:Key="ThumbTile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TileBrush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
</ResourceDictionary>
