<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared navy and orange palette. -->
    <Color x:Key="NavyColor">#0F2E57</Color>
    <Color x:Key="NavyLightColor">#1E4F8A</Color>
    <Color x:Key="OrangeColor">#F68B1E</Color>
    <Color x:Key="OrangeLightColor">#FFB766</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="BackgroundColor">#EEF2F7</Color>
    <Color x:Key="SurfaceSubtleColor">#F9FAFB</Color>
    <Color x:Key="BorderColor">#D6DEE6</Color>
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <Color x:Key="TextSecondaryColor">#64748B</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#DC2626</Color>

    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource NavyColor}"/>
    <SolidColorBrush x:Key="NavyLightBrush" Color="{StaticResource NavyLightColor}"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}"/>
    <SolidColorBrush x:Key="OrangeLightBrush" Color="{StaticResource OrangeLightColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource SurfaceSubtleColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

    <!-- Tints derived from the palette (same hue, low alpha) for badges, icon tiles and states. -->
    <SolidColorBrush x:Key="OrangeTintBrush" Color="#1AF68B1E"/>
    <SolidColorBrush x:Key="OrangeTintStrongBrush" Color="#33F68B1E"/>
    <SolidColorBrush x:Key="SuccessTintBrush" Color="#1F16A34A"/>
    <SolidColorBrush x:Key="WarningTintBrush" Color="#26F59E0B"/>
    <SolidColorBrush x:Key="DangerTintBrush" Color="#1FDC2626"/>
    <SolidColorBrush x:Key="InfoTintBrush" Color="#1F1E4F8A"/>
    <!-- Darker text steps for contrast on tinted badges (warning text on a warning tint fails WCAG with the raw hue). -->
    <SolidColorBrush x:Key="WarningTextBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#94A3B8"/>

    <!-- Sidebar overlays on Primary Navy. -->
    <SolidColorBrush x:Key="NavHoverBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="NavPressedBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="NavTextBrush" Color="#D9FFFFFF"/>
    <SolidColorBrush x:Key="NavMutedBrush" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#990F172A"/>

    <!-- Product placeholder tile. -->
    <SolidColorBrush x:Key="TileBrush" Color="#F1F4F8"/>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.07" Color="#0F2E57"/>
    <DropShadowEffect x:Key="DialogShadow" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.22" Color="#0F172A"/>

    <FontFamily x:Key="UiFont">Inter, Segoe UI Variable Text, Segoe UI, Tahoma</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
</ResourceDictionary>
